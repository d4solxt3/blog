---
import { SITE } from '../site.config';

const path = Astro.url.pathname;
const links = [
  { href: '/', label: 'writing', active: path === '/' || path.startsWith('/posts/') },
  { href: '/about/', label: 'about', active: path.startsWith('/about') },
  { href: '/archive/', label: 'index', active: path.startsWith('/archive') },
];
---

<header class="topbar">
  <nav aria-label="Main">
    <ul>
      {
        links.map((link) => (
          <li>
            <a href={link.href} aria-current={link.active ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <a href="/" class="wordmark" aria-label={`${SITE.name}, home`}>
    <span aria-hidden="true">{SITE.name}</span>
  </a>
</header>

<style>
  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 40px;
    padding: 0 clamp(12px, 2.4vw, 20px);
    border-bottom: 1px solid var(--rule);
  }

  ul {
    display: flex;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li + li::before {
    content: '|';
    margin-inline: clamp(0.5rem, 1.6vw, 0.85rem);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--faint);
  }

  nav a {
    font-family: var(--font-mono);
    font-size: 0.71875rem;
    color: var(--muted);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.4em;
    text-decoration-color: transparent;
    transition:
      color var(--fast) var(--ease),
      text-decoration-color var(--fast) var(--ease);
  }

  nav a:hover {
    color: var(--ink);
    text-decoration-color: var(--rule);
  }

  nav a[aria-current='page'] {
    color: var(--ink);
    text-decoration-color: var(--ink);
  }

  /* Heavy, tight grotesque wordmark — early-2000s studio-site logo energy. */
  .wordmark {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    word-spacing: 0.04em;
    text-decoration: none;
    white-space: nowrap;
    transition: opacity var(--fast) var(--ease);
  }

  .wordmark:hover {
    opacity: 0.72;
  }

  .dot {
    margin-left: 0.02em;
  }

  @media (max-width: 400px) {
    .wordmark {
      font-size: 1.125rem;
    }
  }
</style>
