---
import { SITE } from '../site.config';

const path = Astro.url.pathname;
// "email" uses the email link from your profile links (hidden if there isn't one).
const mail = SITE.profile.links.find((l) => l.url.startsWith('mailto:'));
const links = [
  { href: '/', label: 'home', active: path === '/' },
  { href: '/archive/', label: 'writing', active: path.startsWith('/archive') || path.startsWith('/posts/') },
  { href: '/about/', label: 'about', active: path.startsWith('/about') },
  ...(mail ? [{ href: mail.url, label: 'email', active: false, title: 'send me an email' }] : []),
];
---

<header class="topbar">
  <nav aria-label="Main">
    <ul>
      {
        links.map((link) => (
          <li>
            <a href={link.href} aria-current={link.active ? 'page' : undefined} title={link.title}>
              {link.label}
              {/* One underline that slides between tabs (a shared transition name). */}
              {link.active && <span class="nav-ind" aria-hidden="true" transition:name="nav-indicator" />}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <a href="/" class="wordmark" aria-label={`${SITE.name}, home`}>
    <span aria-hidden="true">{SITE.name}</span>
  </a>
</header>

<style>
  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 30px;
    padding: 0 10px;
    border-bottom: 1px solid var(--line);
  }

  ul {
    display: flex;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li + li::before {
    content: '|';
    margin-inline: 0.5rem;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--faint);
  }

  nav a {
    position: relative;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--muted);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
    text-decoration-color: transparent;
    transition:
      color var(--fast) var(--ease),
      text-decoration-color var(--fast) var(--ease);
  }

  nav a:hover {
    color: var(--ink);
    text-decoration-color: var(--rule);
  }

  nav a[aria-current='page'] {
    color: var(--ink);
    font-weight: 600;
    text-decoration-color: transparent;
  }

  @media (pointer: coarse) {
    .topbar {
      height: 38px;
    }

    nav a {
      display: inline-block;
      padding-block: 8px;
    }

    .nav-ind {
      bottom: 4px !important;
    }
  }

  .nav-ind {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 1px;
    background: var(--ink);
  }

  /* Heavy, tight grotesque wordmark — early-2000s studio-site logo energy. */
  .wordmark {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    text-decoration: none;
    white-space: nowrap;
    transition: opacity var(--fast) var(--ease);
  }

  .wordmark:hover {
    opacity: 0.72;
  }
</style>
