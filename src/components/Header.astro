---
/**
 * The menu as connected folder tabs sitting on the page's top edge. The active
 * tab shares the page surface and covers the seam, with a crisp ink top edge
 * (a shared transition name, so it glides between tabs).
 */
import { SITE } from '../site.config';

const path = Astro.url.pathname;
// "email" uses the email link from your profile links (hidden if there isn't one).
const mail = SITE.profile.links.find((l) => l.url.startsWith('mailto:'));
const links = [
  { href: '/', label: 'home', active: path === '/' },
  { href: '/archive/', label: 'writing', active: path.startsWith('/archive') || path.startsWith('/posts/') },
  { href: '/about/', label: 'about', active: path.startsWith('/about') },
  ...(mail ? [{ href: mail.url, label: 'email', active: false, title: 'send me an email' }] : []),
];
---

<header class="topbar">
  <nav aria-label="Main">
    <ul class="tabs">
      {
        links.map((link) => (
          <li>
            <a class="tab" href={link.href} aria-current={link.active ? 'page' : undefined} title={link.title}>
              {link.label}
              {link.active && <span class="tab-edge" aria-hidden="true" transition:name="nav-indicator" />}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  /* The tab rail: a recessed strip whose bottom edge is the page's top border. */
  .topbar {
    display: flex;
    align-items: flex-end;
    padding: 6px 10px 0;
    border-bottom: 1px solid var(--line);
    background: var(--surface-recessed);
    box-shadow: inset 0 1px 0 var(--bevel-shadow);
  }

  .tabs {
    display: flex;
    align-items: flex-end;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tabs li + li {
    margin-left: -1px;
  }

  .tab {
    position: relative;
    display: block;
    padding: 4px 13px 3px;
    border: 1px solid var(--border-hairline);
    border-bottom: 0;
    background: linear-gradient(var(--surface-raised), var(--surface-raised-low));
    box-shadow: inset 0 1px 0 var(--bevel-highlight);
    font-family: var(--font-mono);
    font-size: 11.5px;
    line-height: 1.4;
    color: var(--muted);
    text-decoration: none;
    transition: color var(--fast) var(--ease);
  }

  .tab:hover {
    z-index: 1;
    border-color: var(--line);
    color: var(--ink);
  }

  /* Active: the page's own surface, a bit taller, covering the seam below. */
  .tab[aria-current='page'] {
    z-index: 2;
    margin-bottom: -1px;
    padding-top: 6px;
    padding-bottom: 4px;
    border-color: var(--line);
    background: var(--surface-main);
    box-shadow: none;
    color: var(--ink);
    font-weight: 600;
  }

  .tab-edge {
    position: absolute;
    top: -1px;
    left: -1px;
    right: -1px;
    height: 2px;
    background: var(--accent);
  }

  .tab:focus-visible {
    z-index: 3;
    outline-offset: -3px;
  }

  @media (pointer: coarse), (max-width: 560px) {
    .tab {
      padding-block: 10px;
      min-height: 36px;
    }

    .tab[aria-current='page'] {
      padding-top: 12px;
      padding-bottom: 10px;
    }
  }

  @media (max-width: 400px) {
    .topbar {
      padding-inline: 6px;
    }

    .tab {
      padding-inline: 9px;
    }
  }
</style>
