---
/**
 * Ultra-faint technical schematic behind the page: concentric arcs,
 * 45° HUD lines, a stadium bracket and node dots. Opacity is set in CSS
 * (.hud-backdrop), colour follows the theme. Purely decorative.
 * With motion set to "full": the outer tick ring turns once every 90s (its own
 * small SVG, rotated as a whole so it stays on the GPU) and three crosshairs
 * pulse. With "quiet" or prefers-reduced-motion it all stays still.
 */
import { SITE } from '../site.config';

const cx = 330;
const cy = 380;
const polar = (x0: number, y0: number, r: number, deg: number) => {
  const a = (deg * Math.PI) / 180;
  return [x0 + r * Math.cos(a), y0 + r * Math.sin(a)] as const;
};
const arc = (x0: number, y0: number, r: number, a0: number, a1: number) => {
  const [xa, ya] = polar(x0, y0, r, a0);
  const [xb, yb] = polar(x0, y0, r, a1);
  return `M${xa.toFixed(1)} ${ya.toFixed(1)} A${r} ${r} 0 ${a1 - a0 > 180 ? 1 : 0} 1 ${xb.toFixed(1)} ${yb.toFixed(1)}`;
};

// The rotating ring lives in its own 532×532 box centred on (cx, cy).
const R = 266;
const ticks = Array.from({ length: 48 }, (_, i) => {
  const deg = i * 7.5 - 90;
  const [x0, y0] = polar(R, R, 262, deg);
  const [x1, y1] = polar(R, R, i % 4 === 0 ? 248 : 255, deg);
  return `M${x0.toFixed(1)} ${y0.toFixed(1)}L${x1.toFixed(1)} ${y1.toFixed(1)}`;
}).join('');
const crosshairs = [
  [90, 90], [860, 120], [1400, 380], [620, 620], [250, 940], [1240, 900], [1440, 720],
];
const pulsing = new Set([1, 3, 5]);
const nodes = [
  [180, 150], [520, 120], [610, 420], [140, 610], [470, 700], [960, 230], [1180, 520], [1320, 160], [1060, 820], [760, 900],
];
---

<div class="hud-backdrop" aria-hidden="true">
  <svg class="hud-main" viewBox="0 0 1500 1000" focusable="false" preserveAspectRatio="xMidYMin meet">
    <g fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke">
      <circle cx={cx} cy={cy} r="44" />
      <circle cx={cx} cy={cy} r="96" stroke-dasharray="3 6" />
      <path d={arc(cx, cy, 150, -120, 140)} />
      <path d={arc(cx, cy, 330, -60, 70)} />
      <path d={arc(cx, cy, 420, 200, 300)} stroke-dasharray="2 8" />
      <path d={`M20 ${cy - 160} H${cx} A160 160 0 0 1 ${cx} ${cy + 160} H20`} stroke-width="2.5" />
      <path d={`M0 ${cy} H${cx + 300}`} stroke-dasharray="4 6" />
      <path d={`M${cx} 0 V${cy + 420}`} stroke-dasharray="4 6" />
      <!-- 45° HUD rails -->
      <path d="M700 40 L900 240 H1240 L1420 60" />
      <path d="M820 980 L1000 800 H1300" />
      <path d="M60 860 L240 680 H520" stroke-dasharray="6 6" />
      <path d="M1100 380 l60 60 h220" />
      <rect x="1010" y="560" width="260" height="120" stroke-dasharray="2 5" />
      <path d="M1010 560 l18 0 M1010 560 l0 18 M1270 680 l-18 0 M1270 680 l0 -18" stroke-width="2" />
    </g>
    <!-- tiny crosshair ticks (two of them pulse) -->
    <g fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke">
      {crosshairs.map(([x, y], i) => <path class:list={{ 'hud-pulse': pulsing.has(i) }} d={`M${x - 7} ${y}h14M${x} ${y - 7}v14`} />)}
    </g>
    <g fill="currentColor">
      {nodes.map(([x, y]) => <circle cx={x} cy={y} r="4" />)}
      <circle cx={cx} cy={cy} r="3" />
    </g>
    <g fill="currentColor" font-family="IBM Plex Mono, monospace" font-size="11" letter-spacing="1">
      <text x="196" y="146">NODE.01</text>
      <text x="536" y="116">ARC 0.42</text>
      <text x="976" y="226">RAIL/45</text>
      <text x="1028" y="580">{SITE.name.toUpperCase()}</text>
    </g>
  </svg>
  <svg class="hud-ring" viewBox={`0 0 ${R * 2} ${R * 2}`} focusable="false">
    <g fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke">
      <path d={arc(R, R, 210, 160, 400)} stroke-width="6" stroke-opacity="0.35" stroke-dasharray="90 14 30 14" />
      <circle cx={R} cy={R} r="262" />
      <path d={ticks} />
    </g>
  </svg>
</div>

<style>
  /* The box matches the main drawing's 1500×1000 viewBox, so the ring can be
     placed in percentages: centre (330, 380), 532 units across. */
  .hud-backdrop {
    aspect-ratio: 3 / 2;
  }

  .hud-main {
    display: block;
    width: 100%;
    height: auto;
  }

  .hud-ring {
    position: absolute;
    left: calc((330 - 266) / 1500 * 100%);
    top: calc((380 - 266) / 1000 * 100%);
    width: calc(532 / 1500 * 100%);
    height: auto;
    aspect-ratio: 1;
    will-change: transform;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(:root[data-motion='full']) .hud-ring {
      animation: hud-spin 90s linear infinite;
    }

    :global(:root[data-motion='full']) .hud-pulse {
      animation: hud-pulse 4s ease-in-out infinite;
    }

    :global(:root[data-motion='full']) .hud-pulse:nth-of-type(4) {
      animation-delay: -1.3s;
    }

    :global(:root[data-motion='full']) .hud-pulse:nth-of-type(6) {
      animation-delay: -2.6s;
    }
  }

  @keyframes hud-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes hud-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.15;
    }
  }
</style>
