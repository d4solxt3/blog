---
/**
 * Black-on-white line art that adapts to the theme with no white box:
 *  paper → multiply (white disappears into the paper)
 *  cyber → cobalt-navy ink; white and transparent areas both stay see-through
 */
import { SITE } from '../site.config';

interface Props {
  src: string;
  alt: string;
  class?: string;
  width?: number;
  height?: number;
  loading?: 'eager' | 'lazy';
}

const { src, alt, class: className, width, height, loading = 'lazy' } = Astro.props;
---

<img
  src={src}
  alt={alt}
  width={width}
  height={height}
  loading={loading}
  decoding="async"
  class:list={['ink-image', className, { 'ink-image--invert': SITE.invertArt }]}
/>

<style>
  .ink-image {
    display: block;
    width: 100%;
    height: auto;
    mix-blend-mode: multiply;
  }

  :global(:root[data-theme='cyber']) .ink-image {
    filter: url(#ink-navy);
    mix-blend-mode: normal;
  }
</style>
