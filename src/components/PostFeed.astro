---
/**
 * The writing list: the main box on the hub pages. A dense early-web link
 * table (date · title + summary · length and replies) with pinned posts set
 * apart above the newest-first list, "all | series | #tags" filters, a small
 * filter box, a visible filter status with a reset, and filters that survive a
 * trip into a post and back. Post titles carry a transition:name, so clicking
 * one glides it into the article header.
 */
import { SITE } from '../site.config';
import { formatDate, isoDate, pad, postUrl, readingTime, tagSlug, threadStatus, seriesOf, type Post } from '../utils/posts';

interface Props {
  posts: Post[];
  label?: string;
  id?: string;
}

const { posts, label = 'writing', id = 'feed' } = Astro.props;
const now = new Date();

const tagCounts = new Map<string, { label: string; count: number }>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    const slug = tagSlug(tag);
    const entry = tagCounts.get(slug) ?? { label: tag, count: 0 };
    entry.count += 1;
    tagCounts.set(slug, entry);
  }
}
const tags = [...tagCounts.entries()].sort((a, b) => b[1].count - a[1].count || a[0].localeCompare(b[0]));

const rows = posts.map((post, i) => {
  const status = threadStatus(post, now);
  return {
    post,
    order: i,
    pinned: status === 'pin',
    flag: status === 'new' ? 'new' : status === 'draft' ? 'draft' : '',
    minutes: readingTime(post.body),
    series: seriesOf(post, posts),
    search: [post.data.title, post.data.subtitle, post.data.description, post.data.series, ...post.data.tags]
      .filter(Boolean)
      .join(' ')
      .toLowerCase(),
  };
});
const hasSeries = rows.some((r) => r.series);
const hasPinned = rows.some((r) => r.pinned) && rows.some((r) => !r.pinned);
const firstLatest = rows.findIndex((r) => !r.pinned);
const repliesEnabled = SITE.comments.provider === 'native';
---

<section class="panel panel--primary feed" id={id} aria-labelledby={`${id}-label`} data-feed-list data-replies={repliesEnabled ? 'on' : 'off'} data-total={posts.length}>
  <div class="panel-bar feed-bar">
    <h2 class="panel-title" id={`${id}-label`}>{label} <span class="count">(<span data-count>{pad(posts.length)}</span>)</span></h2>
    <div class="feed-tools">
      <div class="views" role="group" aria-label="Filter posts">
        <button type="button" class="bevel" data-view="all" aria-pressed="true">all</button>
        {
          hasSeries && (
            <>
              <span class="pipe" aria-hidden="true">|</span>
              <button type="button" class="bevel" data-view="series" aria-pressed="false">
                series
              </button>
            </>
          )
        }
        {
          tags.length > 0 && (
            <>
              <span class="pipe" aria-hidden="true">|</span>
              <button type="button" class="bevel" data-tags-toggle aria-expanded="false" aria-controls={`${id}-tags`}>
                #tags
              </button>
            </>
          )
        }
      </div>
      <label for={`${id}-search`} class="sr-only">Filter posts by text</label>
      <input id={`${id}-search`} class="filter" type="search" placeholder="filter" autocomplete="off" spellcheck="false" data-search />
    </div>
  </div>

  {
    tags.length > 0 && (
      <div class="tag-strip" id={`${id}-tags`} role="group" aria-label="Filter by tag" data-tag-strip hidden>
        {tags.map(([slug, { label: tagLabel, count }]) => (
          <button type="button" class="tag" data-tag={slug} aria-pressed="false">
            #{tagLabel} <span class="n">{count}</span>
          </button>
        ))}
      </div>
    )
  }

  <p class="filter-status" data-filter-status aria-live="polite" hidden>
    <span data-filter-text></span>
    <button type="button" data-reset>clear filters</button>
  </p>

  <ol class="rows" data-rows>
    {
      rows.map(({ post, order, pinned, flag, minutes, series, search }, i) => (
        <>
        {hasPinned && i === firstLatest && (
          <li class="rows-sep" data-sep aria-hidden="true">
            <span>latest</span>
          </li>
        )}
        <li
          class:list={['row', { 'row--pinned': pinned }]}
          data-thread
          data-slug={post.id}
          data-order={order}
          data-pinned={pinned ? '1' : undefined}
          data-tags={post.data.tags.map(tagSlug).join(' ')}
          data-series={series ? `${series.name}::${pad(series.index, 3)}` : ''}
          data-search={search}
        >
          <time class="r-date" datetime={isoDate(post.data.date)}>
            {formatDate(post.data.date)}
          </time>
          <div class="r-main">
            <p class="r-head">
              <a class="r-title" href={postUrl(post)} transition:name={`post-title-${post.id}`}>
                {post.data.title}
              </a>
              {flag && <span class:list={['r-flag', `r-flag--${flag}`]}>{flag}</span>}
            </p>
            <p class="r-sum">
              {series && (
                <span class="r-series">
                  {series.name} {series.index}/{series.total} —{' '}
                </span>
              )}
              {post.data.subtitle ?? post.data.description}
            </p>
          </div>
          <p class="r-meta">
            <span>
              {pinned && (
                <svg class="r-pin" viewBox="0 0 10 10" role="img" aria-label="pinned">
                  <title>pinned</title>
                  <path d="M3 1h4M3.5 1v3.2L2 6h6L6.5 4.2V1M5 6v3.2" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="square" />
                </svg>
              )}
              {minutes} min
            </span>
            {repliesEnabled && <span data-replies hidden />}
          </p>
        </li>
        </>
      ))
    }
  </ol>

  <p class="empty" data-empty hidden>
    nothing matches. <button type="button" data-reset>clear filters</button>
  </p>
</section>

<style>
  .feed-bar {
    flex-wrap: wrap;
    row-gap: 3px;
    padding-block: 2px;
  }

  .feed-tools {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-left: auto;
  }

  .views {
    display: flex;
    align-items: center;
    gap: 3px;
    font-size: 11px;
  }

  .pipe {
    display: none;
  }

  /* all / series / #tags: small raised toggles (the .bevel class); the active one is pressed in. */
  .views button {
    min-height: 17px;
    padding: 0 6px;
    font: inherit;
    line-height: 15px;
  }

  /* The filter box is a recessed well. */
  .filter {
    width: 120px;
    height: 18px;
    padding: 0 5px;
    border: 1px solid var(--border-hairline);
    border-radius: 0;
    background: var(--surface-recessed);
    box-shadow:
      inset 1px 1px 0 var(--bevel-shadow),
      inset -1px -1px 0 var(--bevel-highlight);
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--ink);
  }

  .filter:focus-visible {
    outline: 1px solid var(--ink);
    outline-offset: 0;
  }

  .filter::placeholder {
    color: var(--muted);
    opacity: 1;
  }

  .filter::-webkit-search-cancel-button {
    filter: grayscale(1);
  }

  .tag-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 6px;
    padding: 4px 8px;
    border-bottom: 1px dotted var(--muted);
    background: var(--wash);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .tag,
  .filter-status button,
  .empty button {
    min-height: 22px;
    padding: 0 3px;
    border: 0;
    background: none;
    font: inherit;
    color: var(--muted);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.25em;
    cursor: pointer;
    transition:
      color var(--fast) var(--ease),
      text-decoration-color var(--fast) var(--ease);
  }

  .tag:hover,
  .filter-status button:hover,
  .empty button:hover {
    color: var(--ink);
    text-decoration-color: var(--rule);
  }

  .tag .n {
    color: var(--muted);
  }

  .tag[aria-pressed='true'] {
    background: var(--ink);
    color: var(--surface);
    text-decoration: none;
  }

  .tag[aria-pressed='true'] .n {
    color: inherit;
    opacity: 0.7;
  }

  .filter-status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2px 8px;
    margin: 0;
    padding: 3px 10px;
    border-bottom: 1px dotted var(--muted);
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-2);
  }

  .filter-status button {
    margin-left: auto;
    color: var(--ink);
    text-decoration-color: var(--ink);
  }

  .feed {
    overflow: hidden;
  }

  /* The last row's divider tucks under the panel border. */
  .rows {
    margin: 0 0 -1px;
    padding: 0 10px;
    list-style: none;
  }

  /* date | title + summary | length & replies */
  .row {
    position: relative;
    display: grid;
    grid-template-columns: 70px minmax(0, 1fr) auto;
    column-gap: 10px;
    align-items: baseline;
    padding: 6px 0 6px 12px;
    border-bottom: 1px dotted var(--rule);
  }

  .row:hover {
    background: var(--wash);
    box-shadow:
      -10px 0 0 var(--wash),
      10px 0 0 var(--wash);
  }

  /* Hover: a → pointer slides in and a 2px accent lights up on the left. */
  .row::before {
    content: '→';
    position: absolute;
    top: 6px;
    left: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.45;
    color: var(--ink);
    opacity: 0;
    transform: translateX(-6px);
    transition:
      opacity 140ms var(--snap),
      transform 140ms var(--snap);
  }

  .row::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: -1px;
    left: -10px;
    width: 2px;
    background: var(--ink);
    opacity: 0;
    transition: opacity 140ms var(--snap);
  }

  .row:hover::before,
  .row:focus-within::before {
    opacity: 1;
    transform: none;
  }

  .row:hover::after,
  .row:focus-within::after {
    opacity: 1;
  }

  /* Selection flash: the clicked row deepens to a soft ink wash (fading in),
     then the page transition starts. */
  .row {
    --flash: color-mix(in srgb, var(--ink) 13%, var(--surface));
    transition:
      background-color 120ms var(--snap),
      box-shadow 120ms var(--snap);
  }

  .row.is-flash,
  .row.is-flash:hover {
    background: var(--flash);
    box-shadow:
      -10px 0 0 var(--flash),
      10px 0 0 var(--flash);
  }

  .row.is-flash::before {
    opacity: 1;
    transform: none;
  }

  /* Pinned posts sit on a faint wash above the "latest" divider. */
  .row--pinned {
    background: color-mix(in srgb, var(--wash) 60%, transparent);
    box-shadow:
      -10px 0 0 color-mix(in srgb, var(--wash) 60%, transparent),
      10px 0 0 color-mix(in srgb, var(--wash) 60%, transparent);
  }

  /* Equal space above and below the label (the next row's top padding is trimmed to match). */
  .rows-sep {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 11px 0 2px;
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .rows-sep::after {
    content: '';
    flex: 1;
    border-top: 1px solid var(--rule);
  }

  .rows-sep + .row {
    padding-top: 3px;
  }

  .r-date,
  .r-meta {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--muted);
    white-space: nowrap;
  }

  .r-main {
    min-width: 0;
  }

  .r-head {
    margin: 0;
    line-height: 1.35;
  }

  .row .r-title {
    font-family: var(--font-sans);
    font-size: 13.5px;
    font-weight: 600;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    transition: text-decoration-color var(--fast) var(--ease);
  }

  .row .r-title:visited {
    color: var(--ink-2);
  }

  .row .r-title:hover {
    text-decoration-color: currentColor;
  }

  .row .r-title:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }

  /* Pinned: a tiny pushpin before the reading time, so titles stay aligned. */
  .r-pin {
    display: inline-block;
    width: 9px;
    height: 9px;
    margin-right: 5px;
    vertical-align: -1px;
    color: var(--ink);
  }

  /* Silkscreen micro-badge, no box. */
  .r-flag {
    margin-left: 6px;
    font-family: var(--font-pixel);
    font-size: 9px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink);
    white-space: nowrap;
  }

  .r-flag--draft {
    color: var(--muted);
  }

  /* cyber: a pinpoint crimson pip before NEW (the only red in the theme). */
  :global(:root[data-theme='cyber']) .r-flag--new::before {
    content: '';
    display: inline-block;
    width: 4px;
    height: 4px;
    margin-right: 3px;
    vertical-align: 1px;
    background: var(--signal);
  }

  .r-sum {
    margin: 1px 0 0;
    font-family: var(--font-sans);
    font-size: 12px;
    line-height: 1.45;
    color: var(--muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .r-series {
    color: var(--ink-2);
  }

  .r-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    margin: 0;
    line-height: 1.45;
  }

  .empty {
    margin: 0;
    padding: 8px 10px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
  }

  @media (pointer: coarse), (max-width: 560px) {
    .tag,
    .filter-status button,
    .empty button {
      min-height: 36px;
      padding-inline: 8px;
    }
  }

  /* Narrow: the date joins the meta column under the title. */
  @media (max-width: 480px) {
    .feed-tools {
      width: 100%;
      justify-content: space-between;
    }

    .filter {
      flex: 1;
      max-width: 160px;
      height: 36px;
      font-size: 13px;
    }

    .views button {
      min-height: 36px;
      padding: 0 10px;
    }

    .row {
      grid-template-columns: minmax(0, 1fr) auto;
      padding-block: 8px;
    }

    .r-date {
      grid-column: 2;
      grid-row: 1;
    }

    .r-main {
      grid-column: 1;
      grid-row: 1 / span 2;
    }

    .r-meta {
      grid-column: 2;
      grid-row: 2;
    }

    .row .r-title {
      font-size: 14.5px;
    }

    .r-sum {
      font-size: 12.5px;
    }
  }
</style>

<script>
  import { navigate } from 'astro:transitions/client';
  import { onPage } from '../scripts/lifecycle';

  const pad = (n: number) => String(n).padStart(2, '0');
  const SNAP = 'cubic-bezier(0.19, 1, 0.22, 1)';
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  /** Where to come back to after reading a post: this list, its filters and scroll. */
  const RETURN = 'feed-return';
  type Return = { path: string; search: string; y: number; seenPost?: boolean };

  onPage((signal) => {
    document.querySelectorAll<HTMLElement>('[data-feed-list]').forEach((feed) => {
      const list = feed.querySelector<HTMLElement>('[data-rows]')!;
      const rows = Array.from(feed.querySelectorAll<HTMLElement>('[data-thread]'));
      const sep = feed.querySelector<HTMLElement>('[data-sep]');
      const views = Array.from(feed.querySelectorAll<HTMLButtonElement>('[data-view]'));
      const pills = Array.from(feed.querySelectorAll<HTMLButtonElement>('[data-tag]'));
      const strip = feed.querySelector<HTMLElement>('[data-tag-strip]');
      const toggle = feed.querySelector<HTMLButtonElement>('[data-tags-toggle]');
      const input = feed.querySelector<HTMLInputElement>('[data-search]');
      const countEl = feed.querySelector<HTMLElement>('[data-count]');
      const emptyEl = feed.querySelector<HTMLElement>('[data-empty]');
      const status = feed.querySelector<HTMLElement>('[data-filter-status]');
      const statusText = feed.querySelector<HTMLElement>('[data-filter-text]');
      const total = rows.length;
      const known = new Set(pills.map((p) => p.dataset.tag));
      let view = 'all';
      let tag = '';

      function showTags(open: boolean) {
        if (!strip || !toggle) return;
        strip.hidden = !open;
        toggle.setAttribute('aria-expanded', String(open));
      }

      function apply(updateUrl = true, animate = updateUrl) {
        // FLIP: remember where visible rows were, then glide them to their new places.
        const flip = animate && !reducedMotion.matches;
        const before = new Map<HTMLElement, number>();
        if (flip) {
          for (const row of rows) {
            row.getAnimations().forEach((a) => a.cancel());
            if (!row.hidden) before.set(row, row.getBoundingClientRect().top);
          }
        }
        const terms = (input?.value ?? '').trim().toLowerCase().split(/\s+/).filter(Boolean);
        const sorted = [...rows].sort((a, b) =>
          view === 'series'
            ? (a.dataset.series ?? '').localeCompare(b.dataset.series ?? '')
            : Number(a.dataset.order) - Number(b.dataset.order),
        );
        let shown = 0;
        for (const row of sorted) {
          const match =
            (view !== 'series' || !!row.dataset.series) &&
            (!tag || (row.dataset.tags ?? '').split(' ').includes(tag)) &&
            terms.every((t) => (row.dataset.search ?? '').includes(t));
          row.hidden = !match;
          if (match) shown += 1;
          list.appendChild(row);
        }
        // "latest" divider between the pinned posts and the rest (in the "all" order only).
        if (sep) {
          const firstLatest = sorted.find((r) => !r.hidden && !r.dataset.pinned);
          const anyPinned = sorted.some((r) => !r.hidden && r.dataset.pinned);
          sep.hidden = view !== 'all' || !firstLatest || !anyPinned;
          if (firstLatest) list.insertBefore(sep, firstLatest);
        }
        if (flip) {
          for (const row of rows) {
            if (row.hidden) continue;
            const was = before.get(row);
            const now = row.getBoundingClientRect().top;
            if (was === undefined) {
              row.animate([{ opacity: 0, clipPath: 'inset(0 100% 0 0)' }, { opacity: 1, clipPath: 'inset(0 0 0 0)' }], { duration: 200, easing: SNAP });
            } else if (Math.abs(was - now) > 0.5) {
              row.animate([{ transform: `translateY(${was - now}px)` }, { transform: 'none' }], { duration: 200, easing: SNAP });
            }
          }
        }
        const filtered = view !== 'all' || !!tag || terms.length > 0;
        if (countEl) countEl.textContent = pad(shown);
        if (emptyEl) emptyEl.hidden = shown > 0;
        if (status && statusText) {
          status.hidden = !filtered || shown === 0;
          const parts = [view === 'series' ? 'series only' : '', tag ? `#${pills.find((p) => p.dataset.tag === tag)?.textContent?.trim().replace(/\s+\d+$/, '').replace(/^#/, '') ?? tag}` : '', terms.length ? `“${terms.join(' ')}”` : ''].filter(Boolean);
          statusText.textContent = `showing ${shown} of ${total} · ${parts.join(' · ')}`;
        }
        views.forEach((v) => v.setAttribute('aria-pressed', String(v.dataset.view === view)));
        pills.forEach((p) => p.setAttribute('aria-pressed', String(p.dataset.tag === tag)));
        if (tag) showTags(true);
        if (!updateUrl) return;
        const url = new URL(location.href);
        tag ? url.searchParams.set('tag', tag) : url.searchParams.delete('tag');
        view !== 'all' ? url.searchParams.set('view', view) : url.searchParams.delete('view');
        terms.length ? url.searchParams.set('q', terms.join(' ')) : url.searchParams.delete('q');
        history.replaceState(history.state, '', url);
      }

      function reset() {
        view = 'all';
        tag = '';
        if (input) input.value = '';
        apply();
        input?.focus();
      }

      const params = new URLSearchParams(location.search);
      if (known.has(params.get('tag') ?? '')) tag = params.get('tag')!;
      if (views.some((v) => v.dataset.view === params.get('view'))) view = params.get('view')!;
      if (input && params.get('q')) input.value = params.get('q')!;

      views.forEach((v) =>
        v.addEventListener('click', () => {
          view = v.dataset.view ?? 'all';
          if (view === 'all') tag = '';
          apply();
        }),
      );
      toggle?.addEventListener('click', () => showTags(strip?.hidden ?? false));
      pills.forEach((p) => p.addEventListener('click', () => ((tag = tag === p.dataset.tag ? '' : (p.dataset.tag ?? '')), apply())));
      input?.addEventListener('input', () => apply());
      input?.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && input.value) ((input.value = ''), apply());
      });
      feed.querySelectorAll('[data-reset]').forEach((b) => b.addEventListener('click', reset));

      // Clicking a post: remember this list (filters + scroll), deepen the row
      // for 90ms, then start the page transition.
      for (const row of rows) {
        const link = row.querySelector<HTMLAnchorElement>('.r-title');
        if (!link) continue;
        const unflash = () => row.classList.remove('is-flash');
        link.addEventListener('pointerdown', (e) => e.button === 0 && row.classList.add('is-flash'), { signal });
        link.addEventListener('pointerleave', unflash, { signal });
        link.addEventListener('pointercancel', unflash, { signal });
        link.addEventListener(
          'click',
          (e) => {
            if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return unflash();
            try {
              sessionStorage.setItem(RETURN, JSON.stringify({ path: location.pathname, search: location.search, y: window.scrollY } satisfies Return));
            } catch {}
            if (reducedMotion.matches) return;
            e.preventDefault();
            row.classList.add('is-flash');
            window.setTimeout(() => navigate(link.href), 90);
          },
          { signal },
        );
      }

      document.addEventListener(
        'keydown',
        (e) => {
          const t = e.target as HTMLElement | null;
          if (e.key === '/' && !t?.closest('input, textarea, select, [contenteditable="true"]') && !e.metaKey && !e.ctrlKey) {
            e.preventDefault();
            input?.focus();
          }
        },
        { signal },
      );

      apply(false);

      // Back from a post (browser back or "← writing"): same filters, same scroll position.
      try {
        const saved = JSON.parse(sessionStorage.getItem(RETURN) || 'null') as Return | null;
        if (saved?.seenPost && saved.path === location.pathname && saved.search === location.search) {
          sessionStorage.removeItem(RETURN);
          // Astro has already scrolled the new page to the top; filters are applied, so jump back now.
          window.scrollTo({ top: saved.y, behavior: 'instant' });
        }
      } catch {}

      // Reply counts from the comments API (only shown when there are replies).
      if (feed.dataset.replies === 'on') {
        fetch('/api/comments?counts=1', { headers: { accept: 'application/json' }, signal })
          .then((r) => (r.ok ? r.json() : Promise.reject()))
          .then((counts: Record<string, number>) => {
            rows.forEach((row) => {
              const el = row.querySelector<HTMLElement>('[data-replies]');
              const n = counts[row.dataset.slug ?? ''] ?? 0;
              if (!el || n === 0) return;
              el.textContent = `${n} ${n === 1 ? 'reply' : 'replies'}`;
              el.hidden = false;
            });
          })
          .catch(() => {});
      }
    });
  });
</script>
