---
/**
 * <ZetaTrace /> — the live ζ(½ + it) animation as an MDX component. In plain
 * Markdown (and the writing studio) use the fence instead:
 *
 *   ```zeta
 *   caption: every pass through the origin is a nontrivial zero
 *   ```
 *
 * Both give the same figure (plugins/zeta-trace.mjs), animated by
 * src/scripts/zeta-trace.ts and styled by src/styles/zeta-trace.css.
 *
 *   tMax     how far up the critical line to trace: 15 to 100 (default 50)
 *   caption  optional caption under the figure
 *   title    window title (default "riemann_zeta")
 */
import { toHtml } from 'hast-util-to-html';
import { zetaFigure } from '../../plugins/zeta-trace.mjs';
import '../styles/zeta-trace.css';

interface Props {
  tMax?: number;
  caption?: string;
  title?: string;
}
const html = toHtml(zetaFigure(Astro.props as Props));
---

<Fragment set:html={html} />

<script>
  import '../scripts/zeta-trace';
</script>
