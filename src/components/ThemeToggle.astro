---
/**
 * Tiny "paper / cyber" switch in the on/off style of early-2000s portfolio
 * sites (labels from themeLabels in site.config.json). Visual state is driven
 * by html[data-theme] (set before first paint), so nothing flickers; the script
 * syncs aria-pressed and persists the choice.
 */
import { SITE } from '../site.config';
const { paper, cyber } = SITE.themeLabels;
---

<button type="button" class="theme-switch bevel" data-theme-toggle aria-pressed="false">
  <span class="sr-only">{cyber} theme</span>
  <span class="opt opt-paper" aria-hidden="true">{paper}</span>
  <span class="sep" aria-hidden="true">/</span>
  <span class="opt opt-cyber" aria-hidden="true">{cyber}</span>
  <span class="pip" aria-hidden="true"></span>
</button>

<style>
  /* A raised, glassy little switch (the .bevel class does the material). */
  .theme-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 18px;
    padding: 0 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.65625rem;
    letter-spacing: 0.04em;
    cursor: pointer;
  }

  /* aria-pressed means "cyber is on": keep the raised look either way. */
  .theme-switch[aria-pressed='true'] {
    background: linear-gradient(var(--surface-raised), var(--surface-raised-low));
    box-shadow:
      inset 0 1px 0 var(--bevel-highlight),
      0 1px 0 var(--bevel-shadow);
  }

  .opt {
    color: var(--muted);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.35em;
    text-decoration-color: transparent;
    transition:
      color var(--fast) var(--ease),
      text-decoration-color var(--fast) var(--ease);
  }

  .sep {
    color: var(--faint);
  }

  .theme-switch:hover .opt {
    color: var(--ink);
  }

  :global(:root:not([data-theme='cyber'])) .opt-paper,
  :global(:root[data-theme='cyber']) .opt-cyber {
    color: var(--ink);
    text-decoration-color: var(--ink);
  }

  /* Little power pip: a half-filled disc on paper that turns into a cerulean
     half-filled diamond on cyber. */
  .pip {
    width: 9px;
    height: 9px;
    margin-left: 0.15rem;
    border: 1px solid var(--ink);
    border-radius: 50%;
    background: linear-gradient(90deg, var(--ink) 50%, transparent 50%);
    transition:
      transform 180ms var(--ease),
      border-radius 180ms var(--ease);
  }

  :global(:root[data-theme='cyber']) .pip {
    width: 8px;
    height: 8px;
    border-color: var(--accent);
    border-radius: 0;
    background: linear-gradient(135deg, var(--accent) 50%, transparent 50%);
    transform: rotate(45deg);
  }
</style>

<script>
  import { onPage } from '../scripts/lifecycle';

  type Theme = 'paper' | 'cyber';
  const root = document.documentElement;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const current = (): Theme => (root.dataset.theme === 'cyber' ? 'cyber' : 'paper');

  function sync() {
    document.querySelector('[data-theme-toggle]')?.setAttribute('aria-pressed', String(current() === 'cyber'));
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', current() === 'cyber' ? '#e8f0f8' : '#f3f3f1');
  }

  function swap(theme: Theme, persist: boolean) {
    root.dataset.theme = theme;
    if (persist) {
      try {
        localStorage.setItem('theme', theme);
      } catch {}
    }
    sync();
    document.dispatchEvent(new CustomEvent('themechange', { detail: { theme } }));
  }

  /**
   * With a click origin: the new theme spreads out from the toggle as a soft
   * circle (View Transitions, 720ms). Without View Transitions or with reduced motion
   * the switch is instant.
   */
  function apply(theme: Theme, persist: boolean, origin?: { x: number; y: number }) {
    const vt = (document as Document & { startViewTransition?: (cb: () => void) => { ready: Promise<void>; finished: Promise<void> } })
      .startViewTransition;
    if (origin && vt && !reducedMotion.matches) {
      root.classList.add('theme-wipe');
      const t = vt.call(document, () => swap(theme, persist));
      t.ready
        .then(() => {
          // A soft-edged circle (radial mask, feathered rim) that grows from the
          // toggle, slow at both ends, so the colours melt over rather than cut.
          const r = Math.ceil(Math.hypot(Math.max(origin.x, innerWidth - origin.x), Math.max(origin.y, innerHeight - origin.y)) * 1.35);
          root.animate(
            {
              maskSize: ['0px 0px', `${r * 2}px ${r * 2}px`],
              maskPosition: [`${origin.x}px ${origin.y}px`, `${origin.x - r}px ${origin.y - r}px`],
            },
            { duration: 720, easing: 'cubic-bezier(0.45, 0, 0.25, 1)', pseudoElement: '::view-transition-new(root)', fill: 'both' },
          );
        })
        .catch(() => {});
      t.finished.finally(() => root.classList.remove('theme-wipe'));
      return;
    }
    if (!origin && !reducedMotion.matches) {
      root.classList.add('theme-switching');
      window.setTimeout(() => root.classList.remove('theme-switching'), 200);
    }
    swap(theme, persist);
  }

  onPage((signal) => {
    const toggle = document.querySelector<HTMLElement>('[data-theme-toggle]');
    toggle?.addEventListener(
      'click',
      (e) => {
        // Keyboard clicks have no pointer position: wipe from the button's centre.
        const box = toggle.getBoundingClientRect();
        const pointer = e.clientX || e.clientY;
        const origin = pointer ? { x: e.clientX, y: e.clientY } : { x: box.left + box.width / 2, y: box.top + box.height / 2 };
        apply(current() === 'cyber' ? 'paper' : 'cyber', true, origin);
      },
      { signal },
    );
    sync();
  });
</script>
