---
/** [Aa: Sans | Serif | Mono] — reader's font choice, remembered across posts. */
---

<div class="aa" role="group" aria-label="Reading font">
  <span class="aa-label" aria-hidden="true">Aa:</span>
  <button type="button" class="bevel" data-font-choice="sans" aria-pressed="false">Sans</button>
  <button type="button" class="bevel" data-font-choice="serif" aria-pressed="false">Serif</button>
  <button type="button" class="bevel" data-font-choice="mono" aria-pressed="false">Mono</button>
</div>

<style>
  /* [Aa: Sans | Serif | Mono] — a strip of raised buttons; the chosen one is pressed in. */
  .aa {
    display: inline-flex;
    align-items: stretch;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
  }

  .aa-label {
    display: grid;
    place-items: center;
    padding: 0 0.45rem 0 0;
    font-weight: 700;
    color: var(--muted);
  }

  button {
    min-height: 22px;
    padding: 0.2rem 0.55rem;
    font: inherit;
  }

  button + button {
    margin-left: -1px;
  }

  button[aria-pressed='true'] {
    font-weight: 600;
  }

  @media (pointer: coarse), (max-width: 560px) {
    button {
      min-height: 36px;
      padding-inline: 0.8rem;
    }
  }
</style>

<script>
  import { onPage } from '../scripts/lifecycle';

  onPage((signal) => {
    const root = document.documentElement;
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-font-choice]'));
    const sync = () =>
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.fontChoice === root.dataset.font)));
    buttons.forEach((b) =>
      b.addEventListener(
        'click',
        () => {
          root.dataset.font = b.dataset.fontChoice!;
          try {
            localStorage.setItem('reader-font', b.dataset.fontChoice!);
          } catch {}
          sync();
        },
        { signal },
      ),
    );
    sync();
  });
</script>
