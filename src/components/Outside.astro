---
/** The colophon, sitting on the canvas just under the page's bottom-left edge. */
import { SITE } from '../site.config';
---

<footer class="outside">
  <p class="colophon">{SITE.footerText}</p>
</footer>

<style>
  .outside {
    padding-bottom: clamp(1.75rem, 4vw, 3rem);
  }

  .colophon {
    margin: 0.45rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.02em;
    color: var(--muted);
  }
</style>
