---
import 'katex/dist/katex.min.css';
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProgressBar from '../../components/ProgressBar.astro';
import PostArticle from '../../components/PostArticle.astro';
import Callout from '../../components/Callout.astro';
import Details from '../../components/Details.astro';
import Chart from '../../components/Chart.astro';
import Figure from '../../components/Figure.astro';
import ZetaTrace from '../../components/ZetaTrace.astro';
import { addressOwner } from '../../lib/post-addresses';
import { postUrl } from '../../utils/posts';
import { SITE } from '../../site.config';
import { getPostsByDate, entryCode, readingTime, seriesOf } from '../../utils/posts';

export const prerender = false;
const posts = await getPostsByDate();
const address = Astro.params.slug ?? '';
const owner = addressOwner(address);
const position = posts.findIndex(entry => entry.id === owner);
if (position < 0) {
  const page = await Astro.rewrite('/404');
  const headers = new Headers(page.headers);
  headers.set('Cache-Control', 'no-store');
  return new Response(page.body, { status: 404, headers });
}
const post = posts[position];
if (post.publicAddress !== address) {
  return new Response(null, { status: 302, headers: {
    Location: postUrl(post) + Astro.url.search, 'Cache-Control': 'no-store',
  } });
}
const index = posts.length - position;
const newer = posts[position - 1] ?? null;
const older = posts[position + 1] ?? null;
const series = seriesOf(post, posts);
const { title, subtitle, description, date, updated, tags, tldr, draft, font } = post.data;
// A visibility or metadata change can reuse an existing fully compiled MDX body.
const shipped = post.live?.doc.ext === 'mdx' ? await getEntry('posts', post.id) : null;
const compiled = post.live
  ? shipped && shipped.body?.trim() === post.body.trim() ? await render(shipped) : null
  : await render(post);
const headings = compiled?.headings ?? post.live?.headings ?? [];
const Content = compiled?.Content;
if (post.live) Astro.response.headers.set('Cache-Control', 'no-store');
const toc = headings.filter((h) => (h.depth === 2 || h.depth === 3) && h.slug !== 'footnote-label');
const annotations = SITE.inlineAnnotations && post.data.annotations !== false;
---

<BaseLayout title={title} description={description} type="article" font={font} frame="article">
  <ProgressBar slot="before-frame" />
  <PostArticle
    id={post.id}
    title={title}
    subtitle={subtitle}
    date={date}
    updated={updated}
    tags={tags}
    tldr={tldr}
    minutes={readingTime(post.body)}
    code={entryCode(index)}
    toc={toc}
    series={series}
    older={older}
    newer={newer}
    annotations={annotations}
    badge={draft ? 'draft' : undefined}
    notice={draft ? 'draft — only visible while running npm run dev. set "draft: false" to publish.' : undefined}
  >
    {Content
      ? <Content components={{ Callout, Details, Chart, Figure, ZetaTrace }} />
      : post.live && <Fragment set:html={post.live.html} />}
  </PostArticle>
</BaseLayout>
