---
import 'katex/dist/katex.min.css';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProgressBar from '../../components/ProgressBar.astro';
import Toc from '../../components/Toc.astro';
import Callout from '../../components/Callout.astro';
import Details from '../../components/Details.astro';
import PostFooter from '../../components/PostFooter.astro';
import Comments from '../../components/Comments.astro';
import FontToggle from '../../components/FontToggle.astro';
import SeriesNav from '../../components/SeriesNav.astro';
import QuoteDrawer from '../../components/QuoteDrawer.astro';
import { SITE } from '../../site.config';
import {
  getPostsByDate,
  formatDate,
  isoDate,
  entryCode,
  readingTime,
  seriesOf,
  tagSlug,
  type Post,
  type SeriesInfo,
} from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getPostsByDate();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      index: posts.length - i, // chronological entry number, oldest = 001
      newer: posts[i - 1] ?? null,
      older: posts[i + 1] ?? null,
      series: seriesOf(post, posts),
    },
  }));
}

interface Props {
  post: Post;
  index: number;
  newer: Post | null;
  older: Post | null;
  series: SeriesInfo | null;
}

const { post, index, newer, older, series } = Astro.props;
const { title, subtitle, description, date, updated, tags, tldr, draft, font } = post.data;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => (h.depth === 2 || h.depth === 3) && h.slug !== 'footnote-label');
const minutes = readingTime(post.body);
const code = entryCode(index);
const annotations = SITE.inlineAnnotations && post.data.annotations !== false;

// Subtle 180ms fade-in for the prose and contents column while the frame widens.
const fadeIn = {
  forwards: {
    old: { name: 'hud-fade-out', duration: '120ms', easing: 'linear', fillMode: 'both' },
    new: { name: 'hud-fade-in', duration: '180ms', delay: '80ms', easing: 'linear', fillMode: 'both' },
  },
  backwards: {
    old: { name: 'hud-fade-out', duration: '120ms', easing: 'linear', fillMode: 'both' },
    new: { name: 'hud-fade-in', duration: '180ms', delay: '80ms', easing: 'linear', fillMode: 'both' },
  },
};
---

<BaseLayout title={title} description={description} type="article" font={font} frame="article">
  <ProgressBar slot="before-frame" />

  <article class="post">
    <header class="container post-head">
      <div class="head-top">
        <p class="crumb">
          <a href="/">← writing</a>
          <span class="sep" aria-hidden="true">/</span>
          <span>entry {code}</span>
          {draft && <span class="pixel pixel--dashed">draft</span>}
        </p>
        <FontToggle />
      </div>
      {draft && <p class="draft-banner">draft — only visible while running npm run dev. set "draft: false" to publish.</p>}
      <h1 class="display-title" transition:name={`post-${post.id}`}>{title}</h1>
      {subtitle && <p class="display-subtitle">{subtitle}</p>}
      <p class="meta-line post-meta">
        <time datetime={isoDate(date)}>{formatDate(date)}</time>
        <span class="sep" aria-hidden="true">·</span>
        <span>{minutes} min read</span>
        {
          updated && (
            <>
              <span class="sep" aria-hidden="true">·</span>
              <span>updated {formatDate(updated)}</span>
            </>
          )
        }
        {tags.length > 0 && <span class="sep" aria-hidden="true">·</span>}
        {tags.map((tag) => <a href={`/?tag=${encodeURIComponent(tagSlug(tag))}`}>#{tag}</a>)}
      </p>
    </header>

    <div class="container post-grid">
      <div class="post-main">
        {series && <SeriesNav series={series} position="top" />}
        {toc.length > 0 && <Toc headings={toc} variant="drawer" />}

        <div class="prose" data-post-body transition:name="post-body" transition:animate={fadeIn}>
          {
            tldr && (
              <Callout variant="tldr" label="tl;dr">
                {Array.isArray(tldr) ? (
                  <ul>
                    {tldr.map((line) => (
                      <li>{line}</li>
                    ))}
                  </ul>
                ) : (
                  <p>{tldr}</p>
                )}
              </Callout>
            )
          }
          <Content components={{ Callout, Details }} />
        </div>

        {series && <SeriesNav series={series} position="bottom" />}
        <PostFooter code={code} older={older} newer={newer} />
        <Comments post={post.id} annotations={annotations} />
      </div>

      <!-- Right column, inside the frame: sticky contents + the quote-reply panel. -->
      <aside class="post-side" aria-label="Contents and quote replies" transition:name="post-side" transition:animate={fadeIn}>
        {toc.length > 0 && <Toc headings={toc} variant="sidebar" />}
        {annotations && <QuoteDrawer />}
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  .post-head {
    padding-top: clamp(1.4rem, 4vw, 2.2rem);
    padding-bottom: clamp(1.2rem, 3vw, 1.75rem);
  }

  .head-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem 1rem;
  }

  .crumb {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--muted);
  }

  .crumb a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 0.3em;
    transition: text-decoration-color var(--fast) var(--ease);
  }

  .crumb a:hover {
    text-decoration-color: var(--ink);
  }

  .crumb .sep {
    color: var(--faint);
  }

  .post-meta {
    margin-top: 0.75rem;
    padding-top: 0.6rem;
    border-top: 1px dotted var(--muted);
  }

  .draft-banner {
    margin: 0.8rem 0 0;
    padding: 0.35rem 0.55rem;
    border: 1px dashed var(--line);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
  }

  .post-main {
    min-width: 0;
  }

  /* Single column on narrow screens (contents drawer + bottom-sheet replies). */
  .post-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  /* Wide article frame: reading column + a right column that holds the sticky
     contents (220px) or the quote_thread.exe panel — all inside the border. */
  @media (min-width: 1060px) {
    .post-grid {
      grid-template-columns: minmax(0, 1fr) minmax(16rem, 20rem);
      column-gap: clamp(2rem, 4vw, 3.25rem);
    }

    .post-side {
      padding-left: 1.25rem;
      border-left: 1px dotted var(--muted);
    }

    /* While a quote thread is open it takes the contents' place. */
    .post-side:has(.qt-drawer:not([hidden])) :global(.toc-sidebar) {
      display: none;
    }
  }
</style>

<script>
  import { onPage } from '../../scripts/lifecycle';
  import { initPostPage } from '../../scripts/post-page';

  onPage((signal) => initPostPage(signal));
</script>
