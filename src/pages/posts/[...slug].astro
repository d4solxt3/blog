---
import 'katex/dist/katex.min.css';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProgressBar from '../../components/ProgressBar.astro';
import PostArticle from '../../components/PostArticle.astro';
import Callout from '../../components/Callout.astro';
import Details from '../../components/Details.astro';
import Chart from '../../components/Chart.astro';
import Figure from '../../components/Figure.astro';
import { SITE } from '../../site.config';
import { getPostsByDate, entryCode, readingTime, seriesOf } from '../../utils/posts';

export const prerender = false;
const posts = await getPostsByDate();
const position = posts.findIndex((entry) => entry.id === Astro.params.slug);
if (position < 0) {
  const page = await Astro.rewrite('/404');
  return new Response(page.body, { status: 404, headers: page.headers });
}
const post = posts[position];
const index = posts.length - position;
const newer = posts[position - 1] ?? null;
const older = posts[position + 1] ?? null;
const series = seriesOf(post, posts);
const { title, subtitle, description, date, updated, tags, tldr, draft, font } = post.data;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => (h.depth === 2 || h.depth === 3) && h.slug !== 'footnote-label');
const annotations = SITE.inlineAnnotations && post.data.annotations !== false;
---

<BaseLayout title={title} description={description} type="article" font={font} frame="article">
  <ProgressBar slot="before-frame" />
  <PostArticle
    id={post.id}
    title={title}
    subtitle={subtitle}
    date={date}
    updated={updated}
    tags={tags}
    tldr={tldr}
    minutes={readingTime(post.body)}
    code={entryCode(index)}
    toc={toc}
    series={series}
    older={older}
    newer={newer}
    annotations={annotations}
    badge={draft ? 'draft' : undefined}
    notice={draft ? 'draft — only visible while running npm run dev. set "draft: false" to publish.' : undefined}
  >
    <Content components={{ Callout, Details, Chart, Figure }} />
  </PostArticle>
</BaseLayout>
