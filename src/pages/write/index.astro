---
/** Writing studio home: start a post, or pick one to edit. Owner only. */
import '../../styles/write.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { studioSpellingLanguage } from '../../scripts/spelling-words';
import { isOwner } from '../../lib/auth';
import { SITE } from '../../site.config';
import { listPosts, MODE, postVersion } from '../../lib/content';

export const prerender = false;
if (!isOwner(Astro.request)) return Astro.redirect('/?auth=1&next=/write/');

const posts = listPosts();
const dot = (d: string) => d.replace(/-/g, '.');
const modeLabel =
  MODE === 'off' ? 'off: add GITHUB_TOKEN to publish' : 'publishes to heartcache.xyz';
---

<BaseLayout title="Write" description="Writing studio." banner={false}>
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <h1 class="sr-only">Writing studio</h1>

  <div class="portal portal--wide">
    <section class="panel" aria-labelledby="new-h">
      <div class="panel-bar"><h2 class="panel-title" id="new-h">new post</h2></div>
      <div class="panel-body">
        <form class="studio-form" data-new>
          <label class="sr-only" for="new-title">Title</label>
          <input id="new-title" lang={studioSpellingLanguage(SITE.lang)} name="title" type="text" placeholder="title of the new post" maxlength="300" autocomplete="off" required />
          <button type="submit" class="cm-submit">[ start writing ]</button>
          <span class="status" data-status aria-live="polite"></span>
        </form>
      </div>
    </section>

    <section class="panel" aria-labelledby="list-h">
      <div class="panel-bar">
        <h2 class="panel-title" id="list-h">posts &amp; drafts <span class="count">(<span data-post-count>{posts.length}</span>)</span></h2>
        <span>publishing: {modeLabel}</span>
      </div>
      <ol class="studio-list" data-post-list>
        {posts.map((p) => (
          <li>
            <span class="d">{dot(p.date)}</span>
            <a class="t" href={`/write/${p.slug}`}>
              {p.title}
            </a>
            <span class="flags">
              {p.unsaved ? 'unpublished changes' : p.draft ? 'draft' : 'live'}
            </span>
            <div class="studio-row-actions">
              {MODE === 'github' && (
                <button type="button" class="studio-publish" data-publish={p.slug}
                  data-pending={p.draft || p.unsaved ? 'yes' : 'no'} hidden={!p.draft && !p.unsaved}
                  aria-haspopup="dialog" aria-controls="post-action-dialog" aria-label={`Publish ${p.title}`}>publish</button>
              )}
              <button type="button" class="studio-delete" data-delete={p.slug}
                aria-haspopup="dialog" aria-controls="post-action-dialog" data-version={postVersion(p.publishedSha, p.savedAt)}
                data-file={p.publishedSha ? 'yes' : 'no'} aria-label={`Delete ${p.title}`}>delete</button>
            </div>
          </li>
        ))}
      </ol>
      <p class="panel-body studio-note" data-no-posts hidden={!!posts.length}>nothing yet. start a post above.</p>
      <p class="studio-note studio-result" role="status" data-post-result></p>
    </section>

    <dialog class="win studio-confirm" id="post-action-dialog" aria-labelledby="post-action-heading" aria-describedby="post-action-title post-action-detail">
      <div class="win-bar"><h2 class="win-title" id="post-action-heading">delete post?</h2></div>
      <div class="studio-confirm-body">
        <p class="studio-confirm-title" id="post-action-title"></p>
        <p id="post-action-detail"></p>
        <form method="dialog" class="studio-confirm-actions">
          <button type="submit" class="cm-submit" value="cancel" autofocus>cancel</button>
          <button type="submit" class="cm-submit" value="confirm" data-confirm-action>delete post</button>
        </form>
      </div>
    </dialog>

    <p class="studio-note">
      <kbd>ctrl+shift+e</kbd> opens this page from anywhere · <kbd>e</kbd> on a post edits it · <a href="/write/settings/">settings &amp; password</a>
    </p>
  </div>
</BaseLayout>

<script>
  import { navigate } from 'astro:transitions/client';
  import { onPage } from '../../scripts/lifecycle';

  onPage((signal) => {
    const form = document.querySelector<HTMLFormElement>('[data-new]');
    if (!form) return;
    const list = document.querySelector<HTMLOListElement>('[data-post-list]')!;
    const result = document.querySelector<HTMLElement>('[data-post-result]')!;
    const dialog = document.querySelector<HTMLDialogElement>('#post-action-dialog')!;
    const heading = dialog.querySelector<HTMLElement>('#post-action-heading')!;
    const dialogTitle = dialog.querySelector<HTMLElement>('#post-action-title')!;
    const detail = dialog.querySelector<HTMLElement>('#post-action-detail')!;
    const confirmButton = dialog.querySelector<HTMLButtonElement>('[data-confirm-action]')!;
    const count = document.querySelector<HTMLElement>('[data-post-count]')!;
    const empty = document.querySelector<HTMLElement>('[data-no-posts]')!;
    let selected: HTMLButtonElement | null = null;

    function hasUnsyncedDraft(slug: string) {
      try {
        const snapshot = JSON.parse(localStorage.getItem(`write:${slug}`) ?? 'null');
        return !!snapshot && !snapshot.synced;
      } catch {
        return false;
      }
    }

    function updatePublishButtons() {
      for (const button of list.querySelectorAll<HTMLButtonElement>('button[data-publish]')) {
        button.hidden = button.dataset.pending !== 'yes' && !hasUnsyncedDraft(button.dataset.publish!);
      }
    }

    function showResult(message: string, link?: HTMLAnchorElement) {
      result.textContent = message;
      if (link) result.append(' ', link);
    }

    function openEditorFirst(editor: HTMLAnchorElement) {
      const link = document.createElement('a');
      link.href = editor.href;
      link.textContent = 'Open editor';
      showResult('This browser has unsynced changes. Open the editor and save them before publishing.', link);
      link.focus();
    }

    updatePublishButtons();
    window.addEventListener('storage', updatePublishButtons, { signal });

    list.addEventListener('click', (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>('button[data-delete], button[data-publish]');
      if (!button || button.disabled || selected) return;
      const publishing = button.hasAttribute('data-publish');
      const editor = button.closest('li')!.querySelector<HTMLAnchorElement>('a.t')!;
      if (publishing && hasUnsyncedDraft(button.dataset.publish!)) {
        openEditorFirst(editor);
        return;
      }
      selected = button;
      const hasFile = button.dataset.file === 'yes';
      const action = publishing ? 'publish post' : hasFile ? 'delete post' : 'delete draft';
      heading.textContent = `${action}?`;
      confirmButton.textContent = action;
      dialogTitle.textContent = editor.textContent!.trim();
      detail.textContent = publishing
        ? 'Publish the saved version to heartcache.xyz now? It will go live immediately.'
        : hasFile
          ? 'This removes the post from this site and deletes its saved draft. Its address stays reserved for the original discussion.'
          : 'This permanently removes this saved draft from the studio.';
      // Escape leaves the return value as-is, including after a previous confirmation.
      dialog.returnValue = 'cancel';
      dialog.showModal();
    }, { signal });

    dialog.addEventListener('close', async () => {
      const button = selected;
      selected = null;
      if (!button || !button.isConnected) return;
      if (dialog.returnValue !== 'confirm') {
        button.focus();
        return;
      }
      const row = button.closest('li')!;
      const editor = row.querySelector<HTMLAnchorElement>('a.t')!;
      const deleteButton = row.querySelector<HTMLButtonElement>('button[data-delete]')!;
      const publishButton = row.querySelector<HTMLButtonElement>('button[data-publish]');
      const publishing = button === publishButton;
      const slug = deleteButton.dataset.delete!;
      const title = editor.textContent!.trim();
      if (publishing && hasUnsyncedDraft(slug)) {
        openEditorFirst(editor);
        return;
      }
      const verb = publishing ? 'publish' : 'delete';
      const fallback = `Could not ${verb} “${title}”.`;
      deleteButton.disabled = true;
      if (publishButton) publishButton.disabled = true;
      showResult(`${publishing ? 'Publishing' : 'Deleting'} “${title}”…`);
      let focusTarget: HTMLElement | null = button;
      try {
        const headers = new Headers({ 'If-Match': deleteButton.dataset.version! });
        if (publishing) {
          headers.set('Content-Type', 'application/json');
          headers.set('X-Editor-Action', 'publish');
        }
        const response = await fetch(`/api/write/posts?slug=${encodeURIComponent(slug)}`, {
          method: publishing ? 'POST' : 'DELETE',
          headers, body: publishing ? '{}' : undefined,
        });
        const data = await response.json().catch(() => null);
        if (!response.ok) {
          const message = typeof data?.error === 'string' && data.error ? data.error : fallback;
          const refresh = publishing && [400, 404, 409, 410, 412, 428].includes(response.status);
          throw new Error(refresh ? `${message} Refresh the studio and review the post before trying again.` : message);
        }
        if (publishing) {
          const url = typeof data?.url === 'string' && data.url
            ? URL.parse(data.url, window.location.origin)
            : null;
          if (!url || ![window.location.origin, 'https://heartcache.xyz'].includes(url.origin)
            || typeof data?.version !== 'string' || !data.version.trim()) {
            throw new Error('The publish response could not be verified. Refresh the studio before trying again.');
          }
          deleteButton.dataset.version = data.version;
          deleteButton.dataset.file = 'yes';
          publishButton.dataset.pending = 'no';
          const hasLocalChanges = hasUnsyncedDraft(slug);
          publishButton.hidden = !hasLocalChanges;
          row.querySelector('.flags')!.textContent = hasLocalChanges ? 'live · unsynced changes' : 'live';
          const link = document.createElement('a');
          link.href = url.href;
          link.textContent = 'View public article';
          showResult(`Published “${title}”.`, link);
          focusTarget = link;
        } else {
          try { localStorage.removeItem(`write:${slug}`); } catch {}
          const neighbor = row.nextElementSibling ?? row.previousElementSibling;
          row.remove();
          count.textContent = String(list.children.length);
          empty.hidden = list.children.length > 0;
          showResult(`Deleted “${title}”.${data?.rebuild ? ' The public site updates after the next deployment.' : ''}`);
          focusTarget = neighbor?.querySelector('a') ?? form.querySelector('input');
        }
      } catch (error) {
        showResult(error instanceof Error && error.message !== 'Failed to fetch' ? error.message : fallback);
      } finally {
        deleteButton.disabled = false;
        if (publishButton) publishButton.disabled = false;
        if (!signal.aborted && !dialog.open && document.activeElement === document.body) focusTarget?.focus();
      }
    }, { signal });

    const status = form.querySelector<HTMLElement>('[data-status]')!;
    form.addEventListener(
      'submit',
      async (e) => {
        e.preventDefault();
        const title = (form.elements.namedItem('title') as HTMLInputElement).value.trim();
        if (!title) return;
        status.textContent = 'starting…';
        try {
          const res = await fetch('/api/write/new', {
            method: 'POST',
            headers: { 'content-type': 'application/json', accept: 'application/json' },
            body: JSON.stringify({ title }),
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error ?? 'Could not start the post.');
          navigate(`/write/${data.slug}`);
        } catch (err) {
          status.textContent = err instanceof Error ? err.message : 'Could not start the post.';
        }
      },
      { signal },
    );
  });
</script>
