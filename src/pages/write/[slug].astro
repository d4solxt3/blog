---
/** The editor. Owner only. See src/scripts/write.ts for how it behaves. */
import 'katex/dist/katex.min.css';
import '../../styles/write.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../site.config';
import { studioSpellingLanguage } from '../../scripts/spelling-words';
import { isOwner } from '../../lib/auth';
import { listPosts, metaIndex, MODE, parsePost, readDraft, readPublished, SLUG } from '../../lib/content';

export const prerender = false;
const slug = Astro.params.slug ?? '';
if (!isOwner(Astro.request)) return Astro.redirect(`/?auth=1&next=/write/${SLUG.test(slug) ? slug : ''}`);
if (!SLUG.test(slug)) return Astro.redirect('/write/');

let error = '';
let published = null;
let draft = null;
try {
  const pub = await readPublished(slug);
  published = pub ? { doc: parsePost(slug, pub.ext, pub.source), sha: pub.sha } : null;
  draft = readDraft(slug);
} catch (err) {
  error = err instanceof Error ? err.message : 'Could not load this post.';
}
if (!error && !published && !draft) return Astro.redirect('/write/');

const current = draft ?? published?.doc;
const title = current?.fields.title || slug;
const data = {
  slug,
  mode: MODE,
  published,
  draft,
  siteFont: SITE.defaultFont,
  posts: listPosts().map((p) => ({ slug: p.slug, title: p.title })),
  meta: metaIndex(),
};
const json = JSON.stringify(data).replace(/</g, '\\u003c');
---

<BaseLayout title={`Editing: ${title}`} description="Writing studio." frame="article" banner={false} font={current?.fields.font || undefined}>
  <meta slot="head" name="robots" content="noindex, nofollow" />
  {
    error ? (
      <div class="container" style="padding-block: 2rem">
        <p class="studio-banner">
          couldn't load this post: {error} · <a href="/write/">back to the studio</a>
        </p>
      </div>
    ) : (
      <div class="studio" data-studio lang={studioSpellingLanguage(SITE.lang)}>
        <script type="application/json" data-studio-data set:html={json} />

        <div class="studio-bar">
          <a href="/write/">← studio</a>
          <span class="sb-slug">{slug}</span>
          <span class="sb-state" aria-live="polite">
            <span class="sb-status" data-status title="Server copy (saved 2.5s after you stop typing)">loading…</span>
            <span class="sb-pub" data-pubstate title="Compared with the published post file"></span>
            <span class="sb-local" data-local title="Every keystroke is also kept in this browser" hidden>kept in this browser</span>
          </span>
          <span class="sb-tools">
            <button type="button" data-act="keys" aria-expanded="false" aria-controls="keys">
              <span class="br" aria-hidden="true">[ </span>keys<span class="br" aria-hidden="true"> ]</span>
            </button>
            <button type="button" data-act="media" aria-expanded="false" aria-controls="media-tray">
              <span class="br" aria-hidden="true">[ </span>media <span class="sb-count" data-tray-count></span><span class="br" aria-hidden="true"> ]</span>
            </button>
            <button type="button" data-act="meta" aria-expanded="false" aria-controls="meta">
              <span class="br" aria-hidden="true">[ </span>details<span class="br" aria-hidden="true"> ]</span>
            </button>
            <span class="sb-modes" role="group" aria-label="Layout (Ctrl/Cmd + P toggles the preview)">
              <button type="button" data-mode="split" aria-pressed="false" title="Source and live preview side by side">split</button><button type="button" data-mode="write" aria-pressed="false" title="Source only">write</button><button type="button" data-mode="preview" aria-pressed="false" title="Preview only (Ctrl/Cmd + P)">preview</button>
            </span>
            <button type="button" data-act="focus" aria-pressed="false" title="Ctrl/Cmd + \">
              <span class="br" aria-hidden="true">[ </span>focus<span class="br" aria-hidden="true"> ]</span>
            </button>
            <button type="button" data-act="view" data-view-href={`/write/${slug}/view`} title="Save, then open the post as readers will see it (new tab)">
              <span class="br" aria-hidden="true">[ </span>view as published ↗<span class="br" aria-hidden="true"> ]</span>
            </button>
            <button type="button" data-act="publish" class="sb-publish">
              <span class="br" aria-hidden="true">[ </span>publish<span class="br" aria-hidden="true"> ]</span>
            </button>
          </span>
          <!-- Media tray: drops down under the bar, so the text and caret don't move. -->
          <section class="sb-tray" id="media-tray" data-tray aria-label="Media in this post" hidden>
            <p class="tray-note" data-tray-note>loading…</p>
            <ul class="tray-list" data-tray-list></ul>
          </section>
        </div>

        <!-- One column for banners, details and the canvas, sized like the post's reading column. -->
        <div class="studio-col">
        <div class="studio-banner studio-keys" id="keys" data-keys hidden>
          <dl>
            <dt>/</dt><dd>block menu (at the start of a line)</dd>
            <dt>[[</dt><dd>link another post</dd>
            <dt data-mod>ctrl+b / i / k</dt><dd>bold / italic / link</dd>
            <dt data-mod>ctrl+alt+2 / 3</dt><dd>H2 / H3 heading</dd>
            <dt data-mod>ctrl+shift+8 / 7</dt><dd>bulleted / numbered list</dd>
            <dt>formatting row</dt><dd>tab into it, ← → to move, esc back to the text</dd>
            <dt data-mod>ctrl+shift+f</dt><dd>footnote</dd>
            <dt data-mod>ctrl+p</dt><dd>preview on / off (split, write and preview in the bar)</dd>
            <dt>split view</dt><dd>drag the divider (← → keys too; double-click for 50 / 50); double-click the preview to jump to that line</dd>
            <dt data-mod>ctrl+\</dt><dd>focus mode</dd>
            <dt data-mod>ctrl+s</dt><dd>save now</dd>
            <dt>spelling</dt><dd>Right-click a wavy underline, or place the caret in the word and press Shift+F10, to choose a spelling. Switch off autocorrect to keep suggestions and make every correction yourself.</dd>
            <dt>paste / drop</dt><dd>add an image or gif</dd>
            <dt>/chart</dt><dd>chart from CSV, JSON or a Markdown table, with a live preview</dd>
            <dt>/diagram</dt><dd>boxes and arrows: <code>A[Input] -&gt; B[Output]</code></dd>
            <dt>/figure</dt><dd>images side by side with one caption</dd>
          </dl>
        </div>

        <div class="studio-banner" data-restore hidden>
          <span>this browser has newer text than the server.</span>
          <button type="button" data-restore-yes>
            [ restore it ]
          </button>
          <button type="button" data-restore-no>
            [ discard ]
          </button>
        </div>
        <div class="studio-banner" data-older hidden>
          <span>
            there's a server draft from <time data-older-time></time> based on an older version of this post.
          </span>
          <button type="button" data-older-yes>
            [ open it ]
          </button>
          <button type="button" data-older-no>
            [ delete it ]
          </button>
        </div>
        <div class="studio-banner" data-msg role="status" hidden></div>

        <div class="meta" id="meta" data-meta hidden>
          <label class="wide">
            description (front page &amp; search engines)
            <textarea data-spelling spellcheck="true" autocorrect="off" data-f="description" rows="2" maxlength="1000"></textarea>
          </label>
          <div class="wide meta-group">
            <label>
              tags (comma separated; click a tag below to add or remove it)
              <input type="text" data-f="tags" autocomplete="off" aria-describedby="tag-picks" />
            </label>
            <div class="picks" id="tag-picks" data-tag-picks role="group" aria-label="Existing tags"></div>
          </div>
          <div class="wide meta-group">
            <div class="meta-row">
              <label class="grow">
                series (type a new one or pick below)
                <input type="text" data-f="series" autocomplete="off" />
              </label>
              <label class="narrow">
                part #
                <input type="number" data-f="seriesOrder" min="1" step="1" />
              </label>
            </div>
            <div class="picks" data-series-picks role="group" aria-label="Existing series"></div>
          </div>
          <label>
            date
            <input type="date" data-f="date" />
          </label>
          <label>
            font
            <select data-f="font">
              <option value="">site default ({SITE.defaultFont})</option>
              <option value="sans">sans</option>
              <option value="serif">serif</option>
              <option value="mono">mono</option>
            </select>
          </label>
          <fieldset>
            <legend>status</legend>
            <div class="row">
              <label><input type="radio" name="status" value="draft" data-f="draft" /> draft</label>
              <label><input type="radio" name="status" value="published" data-f="draft" /> published</label>
            </div>
          </fieldset>
          <label class="row">
            <input type="checkbox" data-f="pinned" /> pin to the top
          </label>
        </div>

        </div>

        <!-- Split workspace: source (left) | draggable divider | live preview (right). -->
        <div class="w-split" data-split>
          <section class="w-pane w-pane--source" aria-label="Source">
            <div class="w-pane-sticky">
              <div class="w-pane-bar">
                <span class="w-pane-title" data-source-label>source <span class="w-pane-dim">//</span> markdown</span>
                <button type="button" class="w-spelling-hint" data-spelling-hint hidden></button>
                <label class="w-autocorrect" title="Fix common English typos when you finish a word"><input type="checkbox" data-autocorrect checked /> autocorrect</label>
                <span class="w-pane-meta"><span data-count></span> <span class="w-pane-dim" aria-hidden="true">·</span> <span class="w-pane-status" data-pane-status>saved</span></span>
              </div>
              <div class="w-ribbon-slot" data-ribbon-slot></div>
            </div>
          <div class="canvas">
            <input class="w-title" data-spelling spellcheck="true" autocorrect="off" data-f="title" type="text" placeholder="Title" aria-label="Title" autocomplete="off" />
            <textarea class="w-subtitle" data-spelling spellcheck="true" autocorrect="off" data-f="subtitle" rows="1" placeholder="Subtitle (optional)" aria-label="Subtitle" autocomplete="off"></textarea>
            <div class="w-editor" data-wrap>
            <textarea
              class="w-body"
              data-body
              aria-label="Post body (Markdown)"
              placeholder="Start writing. Type / at the start of a line for blocks, [[ to link a post. Paste or drop images."
              data-spelling spellcheck="true" autocorrect="off"></textarea>
            <div class="w-gutter" data-gutter aria-hidden="true"></div>
            <div class="w-drop" data-drop hidden>
              drop images or gifs to upload
            </div>
          </div>
        </div>
          </section>
          <div class="w-splitter" data-splitter role="separator" aria-orientation="vertical" aria-label="Resize source and preview" aria-controls="w-preview-pane" tabindex="0" aria-valuemin="25" aria-valuemax="75" aria-valuenow="50" title="Drag to resize · double-click for 50 / 50">
            <span class="w-splitter-grip" aria-hidden="true"></span>
          </div>
          <section class="w-pane w-pane--preview" id="w-preview-pane" aria-label="Live preview">
            <div class="w-pane-bar">
              <span class="w-pane-title">preview <span class="w-pane-dim">//</span> live</span>
              <span class="w-pane-tools">
                <span class="w-aa" role="group" aria-label="Preview font">
                  <span class="w-pane-dim" aria-hidden="true">Aa:</span>
                  <button type="button" class="bevel" data-preview-font="sans" aria-pressed="false">Sans</button><button type="button" class="bevel" data-preview-font="serif" aria-pressed="false">Serif</button><button type="button" class="bevel" data-preview-font="mono" aria-pressed="false">Mono</button>
                </span>
                <button type="button" class="bevel w-sync" data-sync aria-pressed="true" title="The preview follows the part of the source you're looking at">sync: <span data-sync-label>on</span></button>
              </span>
            </div>
            <div class="w-preview-scroll" data-preview-scroll tabindex="0" aria-label="Rendered post (double-click a block to jump to its source)">
              <header class="w-preview-head" data-preview-head></header>
              <div class="w-preview prose" data-preview></div>
            </div>
          </section>
        </div>
        <input type="file" data-file accept="image/png,image/jpeg,image/gif,image/webp,image/svg+xml" multiple hidden />

        <!-- Chart dialog (/chart or the ribbon): fields and data | live preview from the real renderer. -->
        <dialog class="win w-chart" data-chart aria-labelledby="w-chart-title">
          <div class="win-bar">
            <h2 class="win-title" id="w-chart-title">chart.exe · insert a chart</h2>
            <button type="button" class="w-chart-x bevel" data-chart-close aria-label="Close without inserting">×</button>
          </div>
          <form class="w-chart-body" data-chart-form novalidate>
            <div class="w-chart-fields">
              <div class="w-chart-row">
                <label>
                  type
                  <select name="type">
                    <option value="line">line</option>
                    <option value="bar">bar</option>
                    <option value="area">area</option>
                    <option value="scatter">scatter</option>
                    <option value="hbar">horizontal bar</option>
                  </select>
                </label>
                <label>
                  id <span class="w-chart-opt">(optional)</span>
                  <input name="id" type="text" autocomplete="off" spellcheck="false" placeholder="e.g. latency" pattern="[a-z0-9\-]*" />
                </label>
              </div>
              <label>
                title
                <input name="title" type="text" autocomplete="off" />
              </label>
              <div class="w-chart-row w-chart-row3">
                <label>
                  x-axis label
                  <input name="xLabel" type="text" autocomplete="off" />
                </label>
                <label>
                  y-axis label
                  <input name="yLabel" type="text" autocomplete="off" />
                </label>
                <label>
                  unit <span class="w-chart-opt">(optional)</span>
                  <input name="unit" type="text" autocomplete="off" placeholder="ms, %, $" />
                </label>
              </div>
              <label>
                caption
                <input name="caption" type="text" autocomplete="off" />
              </label>
              <label class="w-chart-data">
                data
                <span class="w-chart-opt" id="w-chart-help">CSV, JSON (rows or {"{"}columns, rows{"}"}) or a Markdown table. First column is x; the rest are series.</span>
                <textarea name="data" rows="9" spellcheck="false" autocomplete="off" aria-describedby="w-chart-help" placeholder={'month,visits\nJan,120\nFeb,180\nMar,150'}></textarea>
              </label>
            </div>
            <section class="w-chart-preview" aria-labelledby="w-chart-ptitle">
              <h3 class="w-chart-ptitle" id="w-chart-ptitle">preview <span class="w-chart-state" data-chart-state role="status"></span></h3>
              <div class="w-chart-out prose" data-chart-out></div>
              <details class="w-chart-src">
                <summary>source that will be inserted</summary>
                <pre data-chart-src></pre>
              </details>
            </section>
            <div class="w-chart-acts">
              <button type="button" class="bevel" data-chart-close><span class="br" aria-hidden="true">[ </span>cancel<span class="br" aria-hidden="true"> ]</span></button>
              <button type="submit" class="bevel w-chart-insert"><span class="br" aria-hidden="true">[ </span>insert<span class="br" aria-hidden="true"> ]</span></button>
            </div>
          </form>
        </dialog>
      </div>
    )
  }
</BaseLayout>

<script>
  import { onPage } from '../../scripts/lifecycle';
  import { initWriter } from '../../scripts/write';

  onPage((signal) => initWriter(signal));
</script>
