---
/** Personal profile. Everything comes from site.config.json (authorName, authorHandle, profile). */
import BaseLayout from '../layouts/BaseLayout.astro';
import InkImage from '../components/InkImage.astro';
import { SITE } from '../site.config';
import { getPostsByDate, pad, postUrl, formatDate } from '../utils/posts';

const p = SITE.profile;
const posts = await getPostsByDate();
const recent = posts.slice(0, 3);
const statusLabel = ({ online: 'online', away: 'away', offline: 'offline' } as Record<string, string>)[p.status] ?? p.status;
const currently = [
  ['into', p.currently.into],
  ['reading', p.currently.reading],
  ['building', p.currently.building],
].filter(([, v]) => v);
---

<BaseLayout title="About" description={`About @${SITE.authorHandle}`}>
  <div class="container page">
    <h1 class="lsl">about</h1>

    <div class="profile">
      <aside class="card dot-box" aria-label="Profile card">
        <div class="avatar">
          <InkImage src={p.avatar} alt={`Avatar of @${SITE.authorHandle}`} loading="eager" />
        </div>
        <p class="handle">@{SITE.authorHandle}</p>
        {SITE.authorName && <p class="name">{SITE.authorName}</p>}
        <p class="status">
          <span class:list={['pixel', { 'pixel--quiet': p.status !== 'online' }]}>{statusLabel}</span>
        </p>
        <ul class="facts dot-list">
          {p.timezone && (<li><span>timezone</span><span>{p.timezone}</span></li>)}
          {p.joined && (<li><span>here since</span><span>{p.joined}</span></li>)}
          <li><span>posts</span><span>{pad(posts.length)}</span></li>
        </ul>
        {
          p.links.length > 0 && (
            <>
              <p class="lsl">elsewhere</p>
              <ul class="links">
                {p.links.map((l) => (
                  <li>
                    → <a href={l.url}>{l.label}</a>
                  </li>
                ))}
              </ul>
            </>
          )
        }
      </aside>

      <div class="main">
        <section aria-label="Bio">
          <p class="lsl">hello</p>
          <div class="bio">
            {p.bio.map((para) => <p>{para}</p>)}
          </div>
        </section>

        {
          (currently.length > 0 || p.progress.length > 0) && (
            <section class="dot-box" aria-label="Currently">
              <p class="lsl">currently</p>
              {currently.length > 0 && (
                <ul class="now">
                  {currently.map(([k, v]) => (
                    <li>
                      <span class="k">{k}</span>
                      <span>{v}</span>
                    </li>
                  ))}
                </ul>
              )}
              {p.progress.length > 0 && (
                <ul class="progress">
                  {p.progress.map((g) => (
                    <li>
                      <span class="pl">{g.label}</span>
                      <span class="bar" style={`--p: ${g.percent}%`} aria-hidden="true">
                        <i />
                      </span>
                      <span class="pp">{g.percent}%</span>
                    </li>
                  ))}
                </ul>
              )}
            </section>
          )
        }

        {
          SITE.todo.length > 0 && (
            <section aria-label="Checklist">
              <p class="lsl">checklist</p>
              <ul class="check-list">
                {SITE.todo.map((t) => (
                  <li>
                    <span class="box" aria-hidden="true">
                      {t.done ? '[x]' : '[ ]'}
                    </span>
                    <span class:list={{ done: t.done }}>{t.text}</span>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          p.interests.length > 0 && (
            <section aria-label="Interests">
              <p class="lsl">interests</p>
              <p class="interests">
                {p.interests.map((i) => (
                  <span>#{i}</span>
                ))}
              </p>
            </section>
          )
        }

        {
          recent.length > 0 && (
            <section aria-label="Recent posts">
              <p class="lsl">recently written</p>
              <ul class="dot-list recent">
                {recent.map((post) => (
                  <li>
                    <a href={postUrl(post)}>{post.data.title}</a>
                    <span>{formatDate(post.data.date)}</span>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .page {
    padding-top: clamp(1.25rem, 3.5vw, 1.75rem);
  }

  .profile {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    align-items: start;
  }

  @media (min-width: 680px) {
    .profile {
      grid-template-columns: 13rem minmax(0, 1fr);
      gap: 1.6rem;
    }
  }

  .card {
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .avatar {
    width: 8rem;
    margin: 0 auto 0.6rem;
  }

  .handle {
    margin: 0;
    font-family: var(--font-head);
    font-size: 1rem;
    font-weight: 600;
  }

  .name {
    margin: 0.1rem 0 0;
    color: var(--muted);
  }

  .status {
    margin: 0.45rem 0 0.6rem;
  }

  .facts li {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .facts li span:first-child {
    color: var(--muted);
  }

  .facts li span:last-child {
    text-align: right;
  }

  .card .lsl {
    margin-top: 0.85rem;
  }

  .links {
    margin: 0;
    padding: 0;
    list-style: none;
    line-height: 1.7;
  }

  .main {
    display: grid;
    gap: 1.15rem;
  }

  .main section .lsl {
    margin-bottom: 0.4rem;
  }

  .bio p {
    margin: 0;
    max-width: 60ch;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--ink-2);
  }

  .bio p + p {
    margin-top: 0.7rem;
  }

  .now,
  .progress {
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .now li {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 0.5rem;
    padding: 0.2rem 0;
  }

  .now li + li {
    border-top: 1px dotted var(--rule);
  }

  .k {
    color: var(--muted);
  }

  .progress {
    margin-top: 0.6rem;
    padding-top: 0.5rem;
    border-top: 1px dotted var(--muted);
  }

  .progress li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 7.5rem 2.6rem;
    align-items: center;
    gap: 0.6rem;
    padding: 0.2rem 0;
  }

  .pl {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  /* [██████░░░░] — 1px frame, ten segments. */
  .bar {
    position: relative;
    height: 10px;
    border: 1px solid var(--line);
  }

  .bar i {
    position: absolute;
    inset: 1px auto 1px 1px;
    width: calc(var(--p) - 2px);
    max-width: calc(100% - 2px);
    background: var(--ink);
  }

  .bar::after {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(90deg, transparent 0 calc(10% - 1px), var(--surface) calc(10% - 1px) 10%);
  }

  .pp {
    text-align: right;
    color: var(--muted);
  }

  .interests {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.75rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-2);
  }

  .recent li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .recent span {
    color: var(--muted);
    white-space: nowrap;
  }

  a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 0.3em;
    transition: text-decoration-color var(--fast) var(--ease);
  }

  a:hover {
    text-decoration-color: var(--ink);
  }
</style>
