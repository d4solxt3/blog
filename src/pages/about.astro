---
export const prerender = false;
/**
 * Personal profile, built from boxes like the home page: site.config.json →
 * "aboutWidgets" (edit them in /_admin → [pages]); with no key you get the
 * classic about page.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import WidgetGrid from '../components/widgets/WidgetGrid.astro';
import { SITE } from '../site.config';
import { getPostsByDate } from '../utils/posts';

const posts = await getPostsByDate();
---

<BaseLayout title="About" description={`About @${SITE.authorHandle}`}>
  <h1 class="sr-only">About @{SITE.authorHandle}</h1>
  <WidgetGrid page="about" posts={posts} class="about" sideLabel="Profile" />
</BaseLayout>

<style>
  /* Phones: one column: the hello first, then the portrait and profile
     together, then everything else in its usual order. */
  @media (max-width: 699px) {
    :global(.about) {
      display: flex;
      flex-direction: column;
    }

    :global(.about .portal-side),
    :global(.about .portal-main) {
      display: contents;
    }

    :global(.about :is(.panel, .portal-split)) {
      order: 5;
    }

    :global(.about [data-widget='hello']) {
      order: 1;
    }

    :global(.about [data-widget='avatar']) {
      order: 2;
    }

    :global(.about [data-widget='profile']) {
      order: 3;
    }
  }
</style>
