---
export const prerender = false;
/** "writing" in the nav: every post in one table, plus series and topic directories. */
import BaseLayout from '../layouts/BaseLayout.astro';
import PostFeed from '../components/PostFeed.astro';
import { getPosts, pad, postUrl, tagSlug, seriesOf, formatDate } from '../utils/posts';

const posts = await getPosts();

const seriesNames = [...new Set(posts.map((p) => p.data.series).filter(Boolean))] as string[];
const series = seriesNames.map((name) => seriesOf(posts.find((p) => p.data.series === name)!, posts)!);

const tagCounts = new Map<string, { label: string; count: number }>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    const slug = tagSlug(tag);
    const entry = tagCounts.get(slug) ?? { label: tag, count: 0 };
    entry.count += 1;
    tagCounts.set(slug, entry);
  }
}
const tags = [...tagCounts.entries()].sort((a, b) => a[1].label.localeCompare(b[1].label));

const years = new Map<number, number>();
for (const post of posts) {
  const y = post.data.date.getUTCFullYear();
  years.set(y, (years.get(y) ?? 0) + 1);
}
const byYear = [...years.entries()].sort((a, b) => b[0] - a[0]);
---

<BaseLayout title="Writing" description="Every post, plus series and topics.">
  <h1 class="sr-only">Every post</h1>
  <div class="portal portal--wide">
    <PostFeed posts={posts} label="every post" id="index-feed" />

    <div class="dirs">
      <section class="panel" aria-labelledby="series-h">
        <div class="panel-bar">
          <h2 class="panel-title" id="series-h">series</h2>
          <span>{series.length}</span>
        </div>
        <div class="panel-body">
          {
            series.length ? (
              series.map((s) => (
                <div class="series">
                  <p class="panel-sub">{s.name}</p>
                  <ol class="dir">
                    {s.parts.map((p, i) => (
                      <li>
                        <span class="n">{pad(i + 1)}.</span>
                        <a href={postUrl(p)}>{p.data.title}</a>
                        <span class="d">{formatDate(p.data.date)}</span>
                      </li>
                    ))}
                  </ol>
                </div>
              ))
            ) : (
              <p class="none">no multi-part series yet.</p>
            )
          }
        </div>
      </section>

      <div class="dirs-side">
        <section class="panel" aria-labelledby="topics-h">
          <div class="panel-bar">
            <h2 class="panel-title" id="topics-h">topics</h2>
            <span>{tags.length}</span>
          </div>
          <div class="panel-body">
            {tags.length === 0 ? <p class="none">none yet</p> : (<ul class="dir">
              {
                tags.map(([slug, { label, count }]) => (
                  <li>
                    <a href={`/archive/?tag=${encodeURIComponent(slug)}`}>#{label}</a>
                    <span class="d">{count}</span>
                  </li>
                ))
              }
            </ul>)}
          </div>
        </section>

        <section class="panel" aria-labelledby="years-h">
          <div class="panel-bar"><h2 class="panel-title" id="years-h">by year</h2></div>
          <div class="panel-body">
            {byYear.length === 0 ? <p class="none">none yet</p> : (<ul class="dir">
              {
                byYear.map(([y, n]) => (
                  <li>
                    <span>{y}</span>
                    <span class="d">
                      {n} {n === 1 ? 'post' : 'posts'}
                    </span>
                  </li>
                ))
              }
            </ul>)}
          </div>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .dirs {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 8px;
    align-items: start;
  }

  .dirs-side {
    display: grid;
    gap: 8px;
  }

  @media (min-width: 620px) {
    .dirs {
      grid-template-columns: minmax(0, 1fr) 220px;
    }
  }

  .series + .series {
    margin-top: 8px;
  }

  .series .panel-sub {
    margin-top: 0;
  }

  .dir {
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 11.5px;
    line-height: 1.5;
  }

  .dir li {
    display: flex;
    align-items: baseline;
    gap: 6px;
    padding: 2px 0;
  }

  .dir li + li {
    border-top: 1px dotted var(--rule);
  }

  .dir a {
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .n,
  .d {
    color: var(--muted);
  }

  .d {
    margin-left: auto;
    white-space: nowrap;
  }

  .none {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
  }
</style>
