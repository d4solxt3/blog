---
export const prerender = false;
/**
 * Front page: a compact portal of boxes ("widgets"). The order, sidebar/main
 * placement and contents come from site.config.json → "widgets" (edit them in
 * /_admin → [pages]); with no "widgets" key you get the classic layout.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import WidgetGrid from '../components/widgets/WidgetGrid.astro';
import { SITE } from '../site.config';
import { getPosts } from '../utils/posts';

const posts = await getPosts();
---

<BaseLayout>
  <h1 class="sr-only">{SITE.name}</h1>
  <WidgetGrid page="home" posts={posts} class="home" />
</BaseLayout>
