---
/**
 * Front page: a compact portal. Main column first (a short hello, then the
 * writing table, then updates + now); a 245px sidebar beside it (portrait,
 * info & links, todo, note). Everything comes from site.config.json.
 */
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import AsciiArt from '../components/AsciiArt.astro';
import InkImage from '../components/InkImage.astro';
import PostFeed from '../components/PostFeed.astro';
import { SITE } from '../site.config';
import { getPosts } from '../utils/posts';

const posts = await getPosts();
const p = SITE.profile;
const dotDate = (d: string) => d.replace(/-/g, '.');
// Portrait: the ASCII drawing if there is one, otherwise the front-page image.
const hasAscii = existsSync(resolve(process.cwd(), 'public', SITE.frontpageAscii.replace(/^\//, '')));
const currently = [
  ['reading', p.currently.reading],
  ['building', p.currently.building],
  ['into', p.currently.into],
].filter(([, v]) => v);
const hasNow = SITE.status.mood || SITE.status.thought || currently.length > 0;
---

<BaseLayout>
  <h1 class="sr-only">{SITE.name}</h1>

  <div class="portal home">
    <div class="portal-main">
      <section class="panel" aria-labelledby="about-h">
        <div class="panel-bar"><h2 class="panel-title" id="about-h">about</h2></div>
        <div class="panel-body intro">
          <p>{SITE.intro}</p>
          <p class="more">
            <a href="/about/">more about me</a> · <a href="/archive/">every post</a> · <a href="/rss.xml">rss</a>
          </p>
        </div>
      </section>

      <PostFeed posts={posts} label="writing" />

      {
        (SITE.updates.length > 0 || hasNow) && (
          <div class="portal-split">
            {SITE.updates.length > 0 && (
              <section class="panel" aria-labelledby="updates-h">
                <div class="panel-bar">
                  <h2 class="panel-title" id="updates-h">updates</h2>
                </div>
                <ul class="panel-body log">
                  {SITE.updates.map((u) => (
                    <li>
                      <span class="d">{dotDate(u.date)}</span> — {u.text}
                    </li>
                  ))}
                </ul>
              </section>
            )}
            {hasNow && (
              <section class="panel" aria-labelledby="now-h">
                <div class="panel-bar">
                  <h2 class="panel-title" id="now-h">now</h2>
                  {SITE.status.updated && <span>{dotDate(SITE.status.updated)}</span>}
                </div>
                <div class="panel-body mood">
                  {SITE.status.mood && <p class="mood-now">mood: {SITE.status.mood}</p>}
                  {SITE.status.thought && (
                    <p class="ticker" tabindex="0" aria-label={`Current thought: ${SITE.status.thought}`}>
                      <span class="ticker-track" aria-hidden="true">
                        <span>“{SITE.status.thought}”</span>
                        <span class="ticker-copy">“{SITE.status.thought}”</span>
                      </span>
                    </p>
                  )}
                  {currently.length > 0 && (
                    <dl class="kv">
                      {currently.map(([k, v]) => (
                        <>
                          <dt>{k}</dt>
                          <dd>{v}</dd>
                        </>
                      ))}
                    </dl>
                  )}
                </div>
              </section>
            )}
          </div>
        )
      }
    </div>

    <aside class="portal-side" aria-label="About the author">
      <section class="panel" aria-labelledby="portrait-h">
        <div class="panel-bar">
          <h2 class="panel-title" id="portrait-h">@{SITE.authorHandle}</h2>
          <span class="panel-ctl" aria-hidden="true"><i></i></span>
        </div>
        {
          hasAscii ? (
            <button type="button" class="portrait-frame portrait-zoom" data-ascii-open aria-label="Enlarge the drawing">
              <AsciiArt width="100cqi" />
            </button>
          ) : (
            <div class="portrait-frame">
              <InkImage src={SITE.frontpageImage} alt="" loading="eager" />
            </div>
          )
        }
      </section>

      <section class="panel" aria-labelledby="info-h">
        <div class="panel-bar"><h2 class="panel-title" id="info-h">info</h2></div>
        <div class="panel-body">
          <dl class="kv">
            <dt>handle</dt>
            <dd>@{SITE.authorHandle}</dd>
            <dt>status</dt>
            <dd><span class:list={['lamp', { 'lamp--off': p.status !== 'online' }]} aria-hidden="true"></span>{p.status}</dd>
            {p.timezone && (<><dt>tz</dt><dd>{p.timezone}</dd></>)}
          </dl>
          {
            p.links.length > 0 && (
              <>
                <p class="panel-sub">links</p>
                <ul class="px-list">
                  {p.links.map((l) => (
                    <li>
                      <a href={l.url}>{l.label}</a>
                    </li>
                  ))}
                </ul>
              </>
            )
          }
        </div>
      </section>

      {
        SITE.todo.length > 0 && (
          <section class="panel" aria-labelledby="todo-h">
            <div class="panel-bar">
              <h2 class="panel-title" id="todo-h">todo</h2>
              <span>
                {SITE.todo.filter((t) => t.done).length}/{SITE.todo.length}
              </span>
            </div>
            <div class="panel-body">
              <ul class="check-list check-list--mini">
                {SITE.todo.map((t) => (
                  <li>
                    <span class="box" aria-hidden="true">
                      {t.done ? '[x]' : '[ ]'}
                    </span>
                    <span class:list={{ done: t.done }}>{t.text}</span>
                  </li>
                ))}
              </ul>
            </div>
          </section>
        )
      }

      {
        SITE.notice && (
          <section class="panel" aria-labelledby="note-h">
            <div class="panel-bar">
              <h2 class="panel-title" id="note-h">note</h2>
            </div>
            <p class="panel-body note">{SITE.notice}</p>
          </section>
        )
      }
    </aside>
  </div>

  {
    hasAscii && (
      <dialog class="win ascii-viewer" data-ascii-viewer aria-labelledby="ascii-viewer-title">
        <div class="win-bar">
          <span class="win-title" id="ascii-viewer-title">
            drawing
          </span>
          <form method="dialog">
            <button class="ctl ctl-close" aria-label="Close">
              ×
            </button>
          </form>
        </div>
        <div class="ascii-viewer-body">
          <AsciiArt width="min(28rem, calc(100vw - 72px))" />
        </div>
      </dialog>
    )
  }
</BaseLayout>

<script>
  import { onPage } from '../scripts/lifecycle';

  // Click the portrait to see the drawing at full size (up to 9px characters).
  onPage((signal) => {
    const viewer = document.querySelector<HTMLDialogElement>('[data-ascii-viewer]');
    document.querySelector('[data-ascii-open]')?.addEventListener('click', () => viewer?.showModal(), { signal });
    viewer?.addEventListener('click', (e) => e.target === viewer && viewer.close(), { signal });
  });
</script>

<style>
  /* Desktop: sidebar on the left. Phones: the hello and writing come first. */
  @media (min-width: 700px) {
    .home .portal-side {
      grid-column: 1;
      grid-row: 1;
    }

    .home .portal-main {
      grid-column: 2;
      grid-row: 1;
    }
  }

  .intro p {
    margin: 0;
    color: var(--ink-2);
  }

  .intro .more {
    margin-top: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--faint);
  }

  .log {
    max-height: 9.5rem;
    margin: 0;
    padding-left: 10px;
    overflow-y: auto;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.45;
    scrollbar-width: thin;
  }

  .log li {
    padding: 1px 0 1px 1.5em;
    text-indent: -1.5em;
  }

  .log .d {
    color: var(--muted);
  }

  .mood p,
  .note {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11.5px;
    line-height: 1.5;
  }

  .mood-now {
    font-weight: 600;
  }

  .note {
    color: var(--ink-2);
  }

  .mood .kv {
    margin-top: 6px;
    padding-top: 5px;
    border-top: 1px dotted var(--rule);
    font-size: 11px;
  }

  /* The current thought: wraps normally; in "full" motion it scrolls as a ticker. */
  .ticker {
    margin-top: 3px !important;
    overflow: hidden;
    color: var(--ink-2);
  }

  .ticker:focus-visible {
    outline-offset: 1px;
  }

  .ticker-copy {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(:root[data-motion='full']) .ticker-track {
      display: inline-flex;
      gap: 3rem;
      white-space: nowrap;
      animation: ticker 22s linear infinite;
    }

    :global(:root[data-motion='full']) .ticker-copy {
      display: inline;
    }

    :global(:root[data-motion='full']) .ticker:hover .ticker-track,
    :global(:root[data-motion='full']) .ticker:focus-visible .ticker-track {
      animation-play-state: paused;
    }
  }

  @keyframes ticker {
    to {
      transform: translateX(calc(-50% - 1.5rem));
    }
  }

  /* The portrait is a button that opens the large view. */
  .portrait-zoom {
    width: calc(100% - 12px);
    font: inherit;
    color: inherit;
    cursor: zoom-in;
  }

  .ascii-viewer {
    max-width: min(560px, calc(100vw - 32px));
    max-height: calc(100vh - 32px);
    padding: 0;
    color: var(--ink);
  }

  .ascii-viewer::backdrop {
    background: color-mix(in srgb, var(--canvas) 70%, transparent);
  }

  .ascii-viewer-body {
    padding: 12px;
    overflow: auto;
  }
</style>
