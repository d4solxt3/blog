---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found" description="This page doesn't exist.">
  <section class="container page-header lost">
    <p class="label crumb">ERR 404 // signal lost</p>
    <h1 class="display-title">Nothing at this address.</h1>
    <p class="display-subtitle">The page may have moved, or the link may be mistyped.</p>
    <p class="back"><a href="/" class="ui-link">&larr; Return to the index</a></p>
  </section>
</BaseLayout>

<style>
  .back {
    margin-top: 1.75rem;
  }
</style>
