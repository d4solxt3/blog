---
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '@fontsource-variable/ibm-plex-sans/wght.css';
import '@fontsource-variable/ibm-plex-sans/wght-italic.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-400-italic.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '@fontsource/ibm-plex-mono/latin-600.css';
import '@fontsource/silkscreen/latin-400.css';
import '../styles/global.css';
import '../styles/prose.css';
import '../styles/y2k.css';
import BootScreen from '../components/BootScreen.astro';

import plexSans from '@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-wght-normal.woff2?url';
import plexMono from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';

import { ClientRouter } from 'astro:transitions';
import { SITE, type FontChoice } from '../site.config';
import ThemeScript from '../components/ThemeScript.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Header from '../components/Header.astro';
import Outside from '../components/Outside.astro';
import HudBackdrop from '../components/HudBackdrop.astro';
import Banner from '../components/Banner.astro';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  /** Reading font for this page (posts can set `font:` in frontmatter). */
  font?: FontChoice;
  /** "hub" = compact 760px personal site; "article" = wide 1120px reading frame. */
  frame?: 'hub' | 'article';
  /** Show the banner strip under the nav (hub pages only; see "banner" in site.config.json). */
  banner?: boolean;
}

const { title, description = SITE.description, type = 'website', font, frame = 'hub', banner = true } = Astro.props;
const pageFont = font ?? SITE.defaultFont;
const fullTitle = title ? `${title} — ${SITE.name}` : SITE.name;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : null;
const showBanner = frame === 'hub' && banner && SITE.banner.show;
---

<!doctype html>
<html lang={SITE.lang} data-font={pageFont} data-page-font={pageFont} class:list={{ 'soft-borders': !SITE.accentBorders }}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f3f3f1" />
    <ThemeScript />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <!-- No tab icon: an empty one also stops browsers asking for /favicon.ico. -->
    <link rel="icon" href="data:," />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />

    <link rel="preload" href={plexSans} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plexMono} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content={SITE.name} />
    <meta name="twitter:card" content="summary" />

    <!-- Smooth client-side page transitions (falls back to normal loads). -->
    <ClientRouter fallback="none" />
    <slot name="head" />
  </head>
  <body data-tab-animation={JSON.stringify(SITE.tabAnimation)}>
    <a class="skip-link" href="#main">Skip to content</a>
    <!-- Duotone filters for the cyber theme: black → cobalt-navy #14294a, white →
         porcelain #f8fbff (drawings), and a softer cobalt → ice pair (banner). -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <filter id="duo-navy" color-interpolation-filters="sRGB">
        <feColorMatrix type="matrix" values="0.190 0.640 0.065 0 0.078  0.175 0.589 0.059 0 0.161  0.151 0.508 0.051 0 0.290  0 0 0 1 0" />
      </filter>
      <!-- Ink: dark pixels → cobalt-navy, light pixels → transparent (so the
           card's own background shows through, whatever its colour). -->
      <filter id="ink-navy" color-interpolation-filters="sRGB">
        <feColorMatrix type="matrix" values="0 0 0 0 0.078  0 0 0 0 0.161  0 0 0 0 0.290  -0.2126 -0.7152 -0.0722 1 0" />
      </filter>
      <filter id="duo-banner" color-interpolation-filters="sRGB">
        <feColorMatrix type="matrix" values="0.172 0.579 0.058 0 0.114  0.144 0.484 0.049 0 0.310  0.106 0.358 0.036 0 0.549  0 0 0 1 0" />
      </filter>
    </svg>
    {Astro.url.pathname === '/' && <BootScreen />}
    <slot name="before-frame" />
    <div class="shell" id="top" data-frame={frame}>
      <HudBackdrop />
      <div class="frame-box">
      <div class="viewport" transition:name="site-shell" transition:animate={{
        forwards: {
          old: { name: 'hud-fade-out', duration: '120ms', easing: 'linear', fillMode: 'both' },
          new: { name: 'hud-fade-in', duration: '160ms', delay: '60ms', easing: 'linear', fillMode: 'both' },
        },
        backwards: {
          old: { name: 'hud-fade-out', duration: '120ms', easing: 'linear', fillMode: 'both' },
          new: { name: 'hud-fade-in', duration: '160ms', delay: '60ms', easing: 'linear', fillMode: 'both' },
        },
      }}>
        <div class="titlebar">
          <span class="title"><a href="/" aria-label={`${SITE.name}, home`}>{SITE.name}</a><span class="bar-cursor" aria-hidden="true">▮</span><time class="bar-clock" data-clock aria-hidden="true"></time></span>
          <span class="bar-right">
            <span class="tray" aria-hidden="true"><span class="tray-bars"><i></i><i></i><i></i><i></i></span>NET</span>
            <button type="button" class="motion-switch bevel" data-motion-toggle aria-pressed="false" title="Background motion: quiet or full">
              <span class="sr-only">Full motion</span>
              <span class="opt opt-quiet" aria-hidden="true">quiet</span><span class="sep" aria-hidden="true">/</span><span class="opt opt-full" aria-hidden="true">full</span>
            </button>
            <ThemeToggle />
          </span>
        </div>
        {showBanner && <Banner />}
        <Header />
        <main id="main" tabindex="-1">
          <slot />
        </main>
        <!-- Browser-style status bar: the address of the link under the pointer, and a back-to-top. -->
        <div class="winstatus" data-winstatus>
          {frame === 'article' && <span class="winstatus-progress" aria-hidden="true"><span data-progress /></span>}
          <span class="winstatus-text" aria-hidden="true"><span class="winstatus-icon">◫</span><span data-winstatus-text>done</span></span>
          <a class="winstatus-top bevel" href="#top" data-winstatus-top aria-label="Back to top"><span aria-hidden="true">▲</span> <span data-winstatus-pct aria-hidden="true">0%</span></a>
        </div>
      </div>
      <!-- Corner ticks have their own transition names, so they glide outward with the frame. -->
      <i class="frame-tick frame-tick--tl" aria-hidden="true" transition:name="tick-tl"></i>
      <i class="frame-tick frame-tick--tr" aria-hidden="true" transition:name="tick-tr"></i>
      <i class="frame-tick frame-tick--bl" aria-hidden="true" transition:name="tick-bl"></i>
      <i class="frame-tick frame-tick--br" aria-hidden="true" transition:name="tick-br"></i>
      <button type="button" class="frame-grip frame-grip--l" data-frame-grip="-1" tabindex="-1" aria-hidden="true"></button>
      <button type="button" class="frame-grip frame-grip--r" data-frame-grip="1" role="separator" aria-orientation="vertical" aria-label="Window width: drag, or use the arrow keys. Double-click or press Home to reset" title="Drag to resize · double-click to reset"></button>
      </div>
      <!-- Decorations that sit on the frame's edge live outside it: the frame is an
           isolated view-transition group, so blends inside it can't reach the desk. -->
      <div class="frame-edge"><slot name="frame-edge" /></div>
      <Outside />
    </div>
  </body>
</html>

<script>
  import '../scripts/owner-ui';
  import '../scripts/ambient';
  import '../scripts/frame-resize';
  import '../scripts/winstatus';
  import '../scripts/page-enter';
</script>

<style>
  main:focus {
    outline: none;
  }
</style>
